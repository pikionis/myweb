---
import { brands } from '../data/site';
---
<section class="customers wrap" id="customers">
  <header class="head">
    <h2>Brands I've built for</h2>
    <p>Startups, agencies, and a Swiss marketplace — companies that trusted me to design and ship the real thing.</p>
  </header>

  <div id="brandField">
    <canvas id="brandCanvas" aria-hidden="true"></canvas>

    <!-- Keyboard / screen-reader access to the same projects the bubbles show -->
    <ul class="brand-list" aria-label="Projects">
      {brands.map((b, i) => (
        <li><button type="button" data-brand={i}>{b.name}</button></li>
      ))}
    </ul>

    <div class="bmodal" id="bmodal" role="dialog" aria-modal="true" aria-labelledby="bmName" hidden>
      <div class="panel">
        <div class="phone-wrap">
          <div class="phone">
            <div class="notch"></div>
            <div class="screen" id="phoneScreen"></div>
          </div>
        </div>
        <div class="info">
          <button class="close" id="bmClose" type="button" aria-label="Close">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </button>
          <div class="cat" id="bmCat"></div>
          <h3 id="bmName"></h3>
          <p id="bmDesc"></p>
          <a class="visit" id="bmVisit" href="#" target="_blank" rel="noopener">Visit site <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </div>
  <p class="hint">Tap a bubble to see the project</p>
</section>

<script type="application/json" id="brand-data" set:html={JSON.stringify(brands)} />

<style>
  .customers { padding-block: clamp(70px, 10vh, 130px); }
  .head { text-align: center; margin-bottom: 20px; }
  .head h2 { font-size: clamp(2rem, 6vw, 4rem); }
  .head p { color: var(--muted); margin: 16px auto 0; max-width: 46ch; font-size: 1.05rem; }

  #brandField { position: relative; width: 100%; height: clamp(380px, 58vh, 580px); margin-top: 10px; }
  #brandCanvas { position: absolute; inset: 0; width: 100%; height: 100%; cursor: pointer; transition: filter 0.5s ease, opacity 0.5s ease; }
  #brandField.focused #brandCanvas { filter: blur(3px); opacity: 0.35; }

  /* hidden until a keyboard user tabs into it */
  .brand-list { position: absolute; left: 0; bottom: 0; z-index: 4; display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; opacity: 0; pointer-events: none; }
  .brand-list:focus-within { opacity: 1; pointer-events: auto; }
  .brand-list button { background: var(--surface); border: 1px solid var(--line); border-radius: 100px; padding: 8px 14px; cursor: pointer; font-size: 0.85rem; }

  .bmodal { position: absolute; inset: 0; z-index: 10; display: flex; align-items: center; justify-content: center; padding: 10px; }
  .bmodal[hidden] { display: none; }
  .panel {
    background: var(--surface); border: 1px solid var(--line); border-radius: 20px;
    max-width: 780px; width: 100%; max-height: 100%; overflow: auto;
    display: grid; grid-template-columns: 270px 1fr;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.5);
    transform-origin: var(--ox, 50%) var(--oy, 50%);
    animation: pop 0.45s var(--ease-out) both;
  }
  @keyframes pop { from { transform: scale(0.9); opacity: 0; } }

  .phone-wrap { padding: 28px; display: flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--accent) 7%, var(--surface)); border-right: 1px solid var(--line); }
  .phone { width: 200px; aspect-ratio: 9 / 19.5; border-radius: 32px; border: 8px solid #111; background: #000; overflow: hidden; position: relative; box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.6); }
  .notch { position: absolute; top: 8px; left: 50%; transform: translateX(-50%); width: 72px; height: 18px; border-radius: 12px; background: #111; z-index: 3; }
  .screen { position: absolute; inset: 0; }
  .screen :global(video) { width: 100%; height: 100%; object-fit: cover; }
  .screen :global(.fallback) { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; padding: 20px; text-align: center; background: linear-gradient(160deg, #18213a, #0c0d0a); }
  .screen :global(.fallback b) { font-size: 1.3rem; color: #7a9bff; text-transform: uppercase; letter-spacing: -0.02em; }
  .screen :global(.fallback small) { font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; color: #8f948b; }

  .info { padding: 36px 32px; min-width: 0; position: relative; }
  .cat { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-ink); }
  .info h3 { font-size: clamp(1.7rem, 4vw, 2.6rem); margin: 12px 0 16px; padding-right: 40px; }
  .info p { color: var(--muted); line-height: 1.6; margin: 0 0 24px; }
  .visit { display: inline-block; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; border: 1px solid var(--fg); border-radius: 100px; padding: 12px 22px; text-decoration: none; transition: background-color 0.25s ease, color 0.25s ease; }
  .visit:hover { background: var(--fg); color: var(--surface); }
  .visit[hidden] { display: none; }
  .close { position: absolute; top: 16px; right: 16px; width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--line); background: var(--surface); cursor: pointer; display: grid; place-items: center; transition: border-color 0.2s ease; }
  .close:hover { border-color: var(--fg); }

  .hint { text-align: center; margin: 14px 0 0; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }

  @media (max-width: 680px) {
    .panel { grid-template-columns: 112px 1fr; border-radius: 16px; }
    .phone-wrap { padding: 14px 10px; }
    .phone { width: 88px; border-width: 5px; border-radius: 18px; }
    .notch { width: 32px; height: 8px; top: 5px; }
    .screen :global(.fallback b) { font-size: 0.8rem; }
    .screen :global(.fallback small) { display: none; }
    .info { padding: 20px 18px; }
    .info h3 { font-size: 1.5rem; margin: 8px 0 10px; }
    .info p { font-size: 0.92rem; margin-bottom: 16px; }
    .close { top: 10px; right: 10px; width: 34px; height: 34px; }
  }
</style>
