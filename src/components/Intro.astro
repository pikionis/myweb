---
import { hero, person } from '../data/site';
---
<!-- Scroll distance drives the curtain opening; the hero sits behind it.
     The last screen of scroll is where the light sheet slides up over the pinned hero. -->
<div class="intro-scroll" id="top">
  <div class="intro-stage">
    <canvas id="bubbles" aria-hidden="true"></canvas>

    <div class="hero-rev wrap">
      {hero.corners.map((c) => (
        <span class={`corner ${c.pos}`}>{c.top}<br /><b>{c.bold}</b></span>
      ))}
      <div class="hero-inner">
        <div class="hero-copy">
          <h2 class="headline" id="headlineText">{hero.headline}</h2>
          <p class="palette js-words" data-keywords={hero.paletteKeywords.join(',')}>{hero.palette}</p>
          <p class="intro js-words">{hero.intro}</p>
        </div>
        <!-- the portrait, captioned with who this is -->
        <figure class="hero-fig">
          <div class="hero-photo">
            {person.photo ? (
              <img src={person.photo} alt={`Portrait of ${person.name}`} width="480" height="640" />
            ) : (
              <div class="ph" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                <small>public/petros.jpg</small>
              </div>
            )}
          </div>
          <figcaption>
            <span class="cap-name">{person.name}</span>
            <span class="cap-role">{person.role}</span>
          </figcaption>
        </figure>
      </div>
    </div>

    <div class="curtain">
      <div class="half top"></div>
      <div class="half bot"></div>
      <canvas id="ink" aria-hidden="true"></canvas>
      <div class="center">
        <h1>{hero.curtain[0]}<br />{hero.curtain[1]} <span class="a">{hero.curtainAccent}</span></h1>
        <div class="cue"><span class="bar"></span> Scroll to explore</div>
      </div>
    </div>
  </div>
</div>

<style>
  .intro-scroll { height: 420vh; position: relative; }
  .intro-stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  #bubbles { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }

  .curtain { position: absolute; inset: 0; z-index: 5; display: flex; align-items: center; justify-content: center; touch-action: pan-y; }
  /* the ink canvas paints the title once WebGL is up; the real h1 stays for readers and as the fallback */
  #ink { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 6; pointer-events: none; }
  .curtain.inked h1, .curtain.inked .a { color: transparent; }
  .curtain .half { position: absolute; left: 0; right: 0; height: 50%; background: var(--bg); z-index: 6; }
  .curtain .half.top { top: 0; border-bottom: 1px solid var(--line); }
  .curtain .half.bot { bottom: 0; border-top: 1px solid var(--line); }
  .curtain .center { position: relative; z-index: 7; text-align: center; padding-inline: 20px; pointer-events: none; }
  .curtain h1 { font-size: clamp(2.4rem, 8vw, 6rem); }
  .curtain .a { color: var(--accent); }
  .cue {
    margin-top: 36px; display: inline-flex; align-items: center; gap: 10px;
    font-size: 0.72rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted);
  }
  .cue .bar { width: 36px; height: 1px; background: var(--fg); transform-origin: left; animation: cue 2s ease-in-out infinite; }
  @keyframes cue { 0%, 100% { transform: scaleX(0.3); opacity: 0.4; } 50% { transform: scaleX(1); opacity: 1; } }

  .hero-rev { position: absolute; inset: 0; z-index: 4; display: flex; flex-direction: column; justify-content: center; }
  .hero-inner { display: grid; grid-template-columns: 1.5fr 0.5fr; gap: clamp(24px, 4vw, 64px); align-items: center; }
  .headline { font-size: clamp(2.2rem, 6vw, 5rem); transform-style: preserve-3d; will-change: transform; }
  .palette { margin: 28px 0 0; max-width: 46ch; font-size: clamp(1.15rem, 2.6vw, 1.7rem); line-height: 1.45; font-weight: 500; }
  .intro { margin: 22px 0 0; max-width: 60ch; font-size: clamp(0.98rem, 1.9vw, 1.2rem); line-height: 1.6; }

  /* letter reveal: words stay unbreakable, each letter moves on its own */
  .headline :global(.word) { display: inline-block; white-space: nowrap; }
  .headline :global(.ch) { display: inline-block; }

  /* word reveal: only dims once JS has split the words, so no-JS readers see full text */
  .hero-copy :global(.w) { color: color-mix(in srgb, var(--fg) 18%, transparent); transition: color 0.3s ease; }
  .hero-copy :global(.w.lit) { color: var(--fg); }
  .hero-copy :global(.w.key.lit) { color: var(--accent); }

  .hero-fig { margin: 0; max-width: 260px; width: 100%; justify-self: end; }
  .hero-photo {
    position: relative; aspect-ratio: 3 / 4; width: 100%;
    border-radius: 14px; border: 1px solid var(--line); overflow: hidden;
    background: linear-gradient(150deg, #151a24, #0c0d0a);
    display: flex; align-items: center; justify-content: center;
  }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; }
  .ph { display: grid; justify-items: center; gap: 14px; color: var(--accent); }
  .ph small { color: var(--muted); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; }
  figcaption { display: grid; gap: 6px; margin-top: 16px; }
  .cap-name { font-size: 1rem; font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; line-height: 1.1; }
  .cap-role { font-size: 0.72rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }

  .corner { position: absolute; z-index: 8; font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .corner b { color: var(--accent-ink); font-weight: 700; }
  .corner.tl { top: calc(84px + env(safe-area-inset-top, 0px)); left: max(20px, env(safe-area-inset-left, 0px)); }
  .corner.tr { top: calc(84px + env(safe-area-inset-top, 0px)); right: max(20px, env(safe-area-inset-right, 0px)); text-align: right; }
  .corner.bl { bottom: 28px; left: max(20px, env(safe-area-inset-left, 0px)); }
  .corner.br { bottom: 28px; right: max(20px, env(safe-area-inset-right, 0px)); text-align: right; }

  @media (max-width: 820px) {
    .hero-inner { grid-template-columns: 1fr; }
    /* on a phone the portrait opens the copy, its caption beside it so the hero keeps its height */
    .hero-fig { justify-self: start; max-width: none; order: -1; display: flex; align-items: flex-end; gap: 16px; }
    .hero-photo { width: 112px; flex: none; }
    .ph small { font-size: 0.56rem; letter-spacing: 0.04em; }
    figcaption { margin-top: 0; padding-bottom: 4px; }
  }
  /* a short phone: a smaller portrait keeps the copy clear of the menu */
  @media (max-width: 820px) and (max-height: 720px) {
    .hero-photo { width: 84px; }
  }
  @media (max-width: 680px) { .corner { display: none; } }
</style>
