---
// The Kalimera chapter of "My story", "From dawn to daylight" (src/scripts/kalimera.ts plays it; the drawing is
// src/components/kalimera.ts): one morning, 05:30 to noon. Its screen stays while the page scrolls through the
// chapter, a beat at a time: the sky behind, the clock in the corner, the words of the beat at the top and the
// drawing under them. Without script it is the whole chapter at once: the morning as it ends, every beat's words.
import MyStoryArt from './MyStoryArt.astro';
import { art, t, type Scene } from '../data/mystory';

interface Props { scene: Scene }
const { scene } = Astro.props;
const K = art.kalimera;
const says = [scene.text, ...K.beats];
const sun = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>';
---
<div class="kc" data-kc data-clock={K.clock.join(',')}>
  <div class="kc-stage">
    <div class="kc-sky" aria-hidden="true"></div>
    <header class="kc-head">
      <div class="kc-name">
        <p class="kc-label">{t(scene.label)}</p>
        <h3>{scene.title && t(scene.title)}</h3>
      </div>
      <ol class="kc-say">
        {says.map((c, i) => <li data-beat={i}>{t(c)}</li>)}
      </ol>
      <p class="kc-clock" aria-hidden="true"><Fragment set:html={sun} /><span data-clock-now>{K.clock[K.clock.length - 1]}</span></p>
    </header>
    <div class="kc-world"><MyStoryArt name="kalimera" /></div>
  </div>
</div>

<style>
  .kc { --kc-warm: oklch(0.88 0.07 75); position: relative; margin-block: clamp(20px, 3vh, 36px); }
  .kc-stage {
    position: relative; isolation: isolate; display: flex; flex-direction: column; gap: clamp(8px, 1.6vh, 20px);
    padding: clamp(18px, 2.4vw, 32px); border-radius: 20px; overflow: hidden;
  }
  /* the sky: dawn (a touch of ink), then a warm morning, then the light cobalt of full day; the script sets the
     three as the morning goes (without it: noon) */
  .kc-sky {
    position: absolute; inset: 0; z-index: -1; --dusk: 0; --warm: 0; --wash: 1;
    background: color-mix(in srgb, var(--cobalt) calc(var(--wash) * 9%),
      color-mix(in srgb, var(--kc-warm) calc(var(--warm) * 30%), color-mix(in srgb, var(--ink) calc(var(--dusk) * 10%), var(--paper))));
  }
  .kc-head { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: start; gap: 10px clamp(20px, 3vw, 48px); }
  .kc-label {
    margin: 0 0 6px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-weight: 700;
    font-size: clamp(2rem, 4vw, 3.6rem); line-height: 1; letter-spacing: -0.03em;
  }
  .kc-name h3 { margin: 0; font-size: clamp(1.25rem, 1.8vw, 1.6rem); line-height: 1.15; letter-spacing: -0.01em; text-transform: none; }
  .kc-say { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; max-width: 52ch; font-size: clamp(1.05rem, 1.3vw, 1.2rem); line-height: 1.5; }
  .kc-clock {
    display: inline-flex; align-items: center; gap: 8px; margin: 0; padding: 6px 12px; border-radius: 100px;
    background: color-mix(in srgb, var(--paper) 70%, transparent); color: var(--accent-ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-weight: 700; font-size: 1rem; font-variant-numeric: tabular-nums;
  }
  .kc-world { position: relative; aspect-ratio: 3 / 2; }
  .kc-world :global(.ms-svg) { position: absolute; inset: 0; width: 100%; height: 100%; }

  /* with script: the chapter is as tall as its scroll, its screen stays (from under the bar) while it is read, the
     words of one beat at a time */
  .kc.kc-on { height: var(--kc-h); margin-block: 0; }
  .kc.kc-on .kc-stage { position: sticky; top: var(--kc-top); height: var(--kc-stage-h); }
  .kc.kc-on .kc-world { flex: 1; min-height: 0; aspect-ratio: auto; }
  /* (a phone measures the screen at its natural height: the words, and the drawing at its own proportions) */
  .kc.kc-on.kc-measure .kc-stage { height: auto; }
  .kc.kc-on.kc-measure .kc-world { flex: none; aspect-ratio: 3 / 2; }
  .kc.kc-on .kc-say { grid-template-areas: 'say'; }
  .kc.kc-on .kc-say li { grid-area: say; opacity: 0; translate: 0 10px; transition: opacity 0.35s ease, translate 0.5s var(--ease-out); }
  .kc.kc-on .kc-say li.on { opacity: 1; translate: 0 0; }
  .kc-clock.tick :global(span) { animation: kc-tick 0.45s var(--ease-out); }
  @keyframes kc-tick { from { opacity: 0; translate: 0 -6px; } }
  @media (prefers-reduced-motion: reduce) {
    .kc.kc-on .kc-say li { translate: 0 0; }
    .kc-clock.tick :global(span) { animation: none; }
  }

  /* a phone: the name and the clock on top, the words under them, the drawing below */
  @media (max-width: 860px) {
    .kc-stage { padding: 16px; border-radius: 16px; }
    .kc-head { grid-template-columns: minmax(0, 1fr) auto; }
    .kc-say { grid-column: 1 / -1; font-size: 1rem; }
    .kc-clock { grid-column: 2; grid-row: 1; font-size: 0.875rem; padding: 4px 10px; }
    .kc-label { font-size: 1.6rem; }
    .kc-name h3 { font-size: 1.125rem; }
  }
</style>
