---
import { brand } from '../data/site';
import { symbolBox, wordBox, letters } from '../data/logo';
---
<!-- The header lockup, top left: the symbol, the wordmark beside it and the motto under the wordmark. Ink on
     light, ivory on dark; the arc stays cobalt. The intro lands its own logo and motto exactly on these
     boxes (src/scripts/intro.ts). The link is the logo; the motto beside it is plain text. -->
<div class="brand-wrap" data-brand>
  <a class="brand" href="/" aria-label={brand.homeLabel}>
    <svg class="brand-sym" viewBox={`0 0 ${symbolBox.w} ${symbolBox.h}`} aria-hidden="true" focusable="false">
      <use href="#ohl-top" /><use href="#ohl-left" /><use href="#ohl-right" /><use class="arc" href="#ohl-arc" />
    </svg>
    <svg class="brand-word" viewBox={`0 0 ${wordBox.w} ${wordBox.h}`} aria-hidden="true" focusable="false">
      {letters.map((_, i) => <use href={`#ohl-l${i}`} />)}
    </svg>
  </a>
  <p class="brand-motto">{brand.motto}</p>
</div>

<style>
  /* symbol 44 wide (40 tall); the wordmark sits on its upper half, the motto on its lower half */
  .brand-wrap {
    --sym: 44px; --gap: 10px; --word: 80px;
    position: relative; flex: none; pointer-events: auto;
    color: var(--logo-ink, var(--ink)); transition: color 0.3s ease;
  }
  .brand { display: flex; align-items: flex-start; gap: var(--gap); color: inherit; border-radius: 6px; }
  .brand-sym, .brand-word { display: block; height: auto; fill: currentColor; overflow: visible; }
  .brand-sym { width: var(--sym); }
  .brand-word { width: var(--word); margin-top: calc(var(--sym) * 0.09); }
  .arc { fill: var(--cobalt); }
  .brand:focus-visible { outline-offset: 6px; }
  .brand-motto {
    position: absolute; left: calc(var(--sym) + var(--gap)); top: calc(var(--sym) * 0.58); margin: 0;
    font-size: 0.6875rem; font-weight: 500; line-height: 1.2; letter-spacing: 0.01em; white-space: nowrap;
    color: color-mix(in srgb, currentColor 72%, transparent);
  }
  /* the intro owns the logo until it lands here */
  :global(html[data-intro='full']) .brand-wrap, :global(html[data-intro='still']) .brand-wrap { visibility: hidden; }
  /* later page loads: the logo only fades in */
  :global(html[data-intro='quick']) .brand-wrap { animation: brand-in 0.4s var(--ease-out) both; }
  @keyframes brand-in { from { opacity: 0; } }
  @media (max-width: 820px) {
    .brand-wrap { --sym: 40px; --gap: 9px; --word: 72px; }
    .brand-motto { font-size: 0.625rem; }
  }
</style>
