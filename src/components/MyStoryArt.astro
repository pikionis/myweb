---
// One drawing per scene of "My story" (src/data/mystory.ts), by scene id: single-line art in ink on the paper,
// with cobalt as the one accent ("One Continuous Line"). Each is drawn as it ends, which is how it rests with
// reduced motion or no script; src/scripts/mystory.ts draws it from nothing as the scene is scrolled through.
// Every scene but the first is entered by its `lead`, the line coming in from the left (from the timeline), so
// the line never breaks. Parts the script moves are named by data-p; strokes draw on as in the stories.
import { r1, C, R, P as pen, D, cls } from './lineart';
import { type N, P, G, F, X, width, written, pill, person, doc, poly, block, walker, cheer, cloud, burst } from './storypen';
import { art as A, t } from '../data/mystory';
import { kalimeraArt, VIEW as KC, SUN } from './kalimera';
import { koanArt, VIEW as KO } from './koan';
import { deindealArt, VIEW as DD } from './deindeal';

interface Props { name: string }
const { name } = Astro.props;

// ---- the journey, 2009 to 2016: a train on a rollercoaster through seven years of study ----
// The track runs from station to station: a flat stretch at each, where the train stops and loads one more skill,
// and a hill between them (one of them a loop; the highest, in cobalt, Artificial Intelligence). The script moves a
// camera along it (the far hills and the clouds slower, for depth) and lays the cars along the track, each turned
// with it. It is drawn twice, for a wide window and a narrow one; the script uses the one shown.
const RL = 400;
const J = { h: 480, first: 800, seg: 1400, hill: 560, hills: [120, 160, 0, 190, 250, 150, 175, 130], loop: 2, ai: 4 };
const segX = (k: N) => 880 + k * J.seg;
/** where the train's front stops at station k (0 is the start, 8 the end of the line): the whole train on the flat */
const stopX = (k: N) => (k === 0 ? J.first : segX(k) - 60);
const WORLD = segX(8) + 300;
const bez = (a: N[], b: N[], c: N[], d: N[], q: N) => {
  const u = 1 - q;
  return [0, 1].map((i) => u * u * u * a[i] + 3 * u * u * q * b[i] + 3 * u * q * q * c[i] + q * q * q * d[i]);
};
/** the track: flat at the stations, a hill (or the loop) between them; the supports under it; the AI hill */
const coasterTrack = () => {
  let d = `M0 ${RL}H880`, posts = '', ai = '', aiTop = [0, 0];
  for (let k = 0; k < 8; k++) {
    const x = segX(k), h = J.hills[k];
    if (k === J.loop) {
      d += `H${x + 200}C${x + 330} ${RL} ${x + 372} ${RL - 190} ${x + 280} ${RL - 190}C${x + 188} ${RL - 190} ${x + 232} ${RL} ${x + 360} ${RL}H${x + J.hill}`;
    } else {
      const up = [[x, RL], [x + 130, RL], [x + 170, RL - h], [x + 280, RL - h]], down = [[x + 280, RL - h], [x + 390, RL - h], [x + 430, RL], [x + 560, RL]];
      const seg = `C${x + 130} ${RL} ${x + 170} ${RL - h} ${x + 280} ${RL - h}C${x + 390} ${RL - h} ${x + 430} ${RL} ${x + J.hill} ${RL}`;
      d += seg;
      if (k === J.ai) { ai = `M${x} ${RL}${seg}`; aiTop = [x + 280, RL - h]; }
      // it stands on supports wherever it leaves the ground
      for (const c of [up, down]) for (let i = 1; i < 8; i++) {
        const [px, py] = bez(c[0], c[1], c[2], c[3], i / 8);
        if (RL - py > 16) posts += `M${r1(px)} ${r1(py + 6)}V${RL + 34}`;
      }
    }
    d += `H${x + J.seg}`;
  }
  d += `H${WORLD}`;
  return { d, posts, ai, aiTop };
};
/** a wheel on the rail: rim, spokes, hub; the script turns it */
const wheel = (p: string, cx: N, r: N) => G(p,
  pen(C(cx, RL - r, r)) + pen(`M${r1(cx - r * 0.72)} ${RL - r}H${r1(cx + r * 0.72)}M${cx} ${r1(RL - r - r * 0.72)}V${r1(RL - r + r * 0.72)}`, 'thin') +
  `<circle class="fill-ink" cx="${cx}" cy="${RL - r}" r="2.5"/>`, `data-cx="${cx}" data-cy="${RL - r}" data-r="${r}"`);
const LOCO = 186, WAGON = 170;
/** the train: the engine, then three wagons. Each car is drawn about its own middle, on the rail (y = 0), so the
 *  script can set it on the track and turn it with it. The wagons carry the skills: the first ones from the start,
 *  then one more from every station (data-at: the station that loads it) */
const train = () => {
  const engine = [
    P(R(-170, 304, 46, 74, 4), 'solid'), P('M-178 304H-116L-121 295H-173Z', 'solid'), pen(R(-160, 316, 26, 22, 3), 'thin'),
    P(R(-128, 334, 118, 44, 21), 'solid'), F('M-107 336H-12V376H-107Z', 'face-l'), pen('M-100 334V378M-58 334V378', 'thin'),
    P(R(-14, 330, 14, 50, 4), 'solid'), pen(C(-7, 354, 5), 'thin'),
    P('M-46 334V312L-52 300H-22L-28 312V334', 'solid'), pen('M-92 334C-92 316 -70 316 -70 334'),
    pen('M-170 380H2', 'thick-ish'), P('M0 380L16 400H0Z', 'solid'),
    `<circle class="ac-fill" cx="-7" cy="324" r="5"/>`,
    wheel('wheel-0', -114, 18), wheel('wheel-1', -72, 18), wheel('wheel-2', -26, 11),
    `<path class="rod" data-p="rod" d="M-105 382L-63 382"/>`,
    G('smoke', [0, 1, 2, 3].map((k) => `<circle class="puff" data-p="puff-${k}" cx="-37" cy="292" r="${7 + k * 2}"/>`).join('')),
  ].join('');
  // the skills, in the order they come on board, and the slots they fill: the lower row of every wagon, then the upper
  const skills = [...A.cargo.first.map((l) => [l, 0] as const), ...A.cargo.stops.map((l, i) => [l, i + 1] as const)];
  const slots: N[][] = [];
  for (const row of [0, 1]) for (const w of [0, 1, 2]) for (const col of [0, 1]) slots.push([w, row, col]);
  const crates: string[][] = [[], [], []];
  skills.forEach(([label, at], i) => {
    const [w, row, col] = slots[i];
    const x = -85 + 8 + col * 81, y = 306 - row * 36, ai = label === 'AI';
    crates[w].push(G(`crate-${i}`, (ai ? `<path class="ac-fill" d="${R(x, y, 73, 34, 4)}"/>` : P(R(x, y, 73, 34, 4), 'solid ac')) +
      X(x + 36.5, y + 22, label, 11, ai ? 'mid mono bold t-inv' : 'mid mono bold'), `data-at="${at}"`));
  });
  const wagons = [0, 1, 2].map((k) => G(`car-${k + 1}`, `<g transform="translate(0 ${-RL})">` +
    pen('M85 372H97') + P(R(-85, 340, 170, 40, 4), 'solid') + pen('M-77 352H77', 'thin') +
    wheel(`wheel-${3 + k * 2}`, -55, 12) + wheel(`wheel-${4 + k * 2}`, 55, 12) + crates[k].join('') + '</g>', `data-len="${WAGON}"`)).join('');
  return G('train', wagons + G('car-0', `<g transform="translate(77 ${-RL})">${engine}</g>`, `data-len="${LOCO}"`));
};
/** what the years held, as small pictures along the way, each with its words under it */
const journeyMoment = (k: number, cx: N) => {
  // above the train's roof, so its words stay in sight as it passes
  const x = cx - 75, y = 112;
  const pic = [
    // lectures
    () => P(R(x + 20, y + 6, 110, 62, 4), 'solid') + pen(`M${x + 34} ${y + 24}H${x + 96}M${x + 34} ${y + 40}H${x + 82}`) +
      [36, 62, 88, 114].map((hx) => pen(C(x + hx, y + 92, 7)) + pen(`M${x + hx - 12} ${y + 116}C${x + hx - 12} ${y + 104} ${x + hx + 12} ${y + 104} ${x + hx + 12} ${y + 116}`)).join(''),
    // study nights at friends' houses: a lit window, heads over the books, the moon
    () => P(`M${x + 20} ${y + 118}V${y + 58}L${x + 75} ${y + 16}L${x + 130} ${y + 58}V${y + 118}Z`, 'solid') +
      `<rect class="glow" data-p="glow" x="${x + 44}" y="${y + 66}" width="62" height="38" rx="3"/>` +
      [58, 75, 92].map((hx) => pen(C(x + hx, y + 84, 5.5)) + pen(`M${x + hx - 9} ${y + 104}C${x + hx - 9} ${y + 94} ${x + hx + 9} ${y + 94} ${x + hx + 9} ${y + 104}`)).join('') +
      pen(`M${x + 146} ${y - 6}A14 14 0 1 0 ${x + 150} ${y + 20}A11 11 0 1 1 ${x + 146} ${y - 6}Z`),
    // experiments in the lab: a flask that bubbles, a scope with its wave
    () => pen(`M${x + 6} ${y + 118}H${x + 144}`) +
      P(`M${x + 38} ${y + 40}V${y + 68}L${x + 16} ${y + 116}H${x + 82}L${x + 60} ${y + 68}V${y + 40}Z`, 'solid') +
      F(`M${x + 24} ${y + 100}L${x + 18} ${y + 114}H${x + 80}L${x + 74} ${y + 100}Z`, 'ac-fill') +
      [0, 1, 2].map((b) => `<circle class="bubble" data-p="bubble" cx="${x + 42 + b * 8}" cy="${y + 96}" r="${2.5 + b * 0.6}"/>`).join('') +
      P(R(x + 92, y + 58, 54, 48, 4), 'solid') + pen(`M${x + 98} ${y + 82}q6 -14 12 0t12 0t12 0t12 0`, 'ac'),
    // six months of PostgreSQL: a database, two tables joined, and a drop of sweat
    () => pen(`M${x + 22} ${y + 30}v56a24 9 0 0 0 48 0v-56`) + pen(`M${x + 22} ${y + 30}a24 9 0 0 0 48 0a24 9 0 0 0 -48 0`) + pen(`M${x + 22} ${y + 58}a24 9 0 0 0 48 0`, 'thin') +
      P(R(x + 86, y + 20, 56, 34, 3), 'solid') + pen(`M${x + 86} ${y + 32}H${x + 142}`, 'thin') + P(R(x + 86, y + 76, 56, 34, 3), 'solid') + pen(`M${x + 86} ${y + 88}H${x + 142}`, 'thin') +
      pen(`M${x + 114} ${y + 54}V${y + 76}`, 'ac') + F(`M${x + 12} ${y + 6}c-6 9 -9 14 -9 18a9 9 0 0 0 18 0c0 -4 -3 -9 -9 -18z`, 'ac-fill', 'data-p="sweat"'),
    // big group projects: a board of notes, and the team at it
    () => P(R(x + 18, y + 4, 114, 70, 4), 'solid') +
      [[30, 16], [62, 16], [94, 16], [30, 44], [62, 44]].map(([nx, ny], i) => `<rect class="${i % 2 ? 'note' : 'note ac-note'}" x="${x + nx}" y="${y + ny}" width="24" height="20" rx="2"/>`).join('') +
      [30, 60, 90, 120].map((hx) => pen(C(x + hx, y + 92, 7)) + pen(`M${x + hx - 12} ${y + 118}C${x + hx - 12} ${y + 104} ${x + hx + 12} ${y + 104} ${x + hx + 12} ${y + 118}`)).join(''),
    // Python
    () => P(R(x + 12, y + 18, 126, 84, 8), 'solid') + pen(`M${x + 12} ${y + 38}H${x + 138}`) + D(x + 24, y + 28, 3) + D(x + 34, y + 28, 3) + D(x + 44, y + 28, 3) +
      X(x + 22, y + 62, '>>> print("Hello")', 11, 'mono') + X(x + 22, y + 84, 'Hello', 11, 'mono t-ac bold') +
      pen(`M${x + 120} ${y + 120}c-16 0 -16 -14 0 -14s16 -14 0 -14`, 'ac thick-ish'),
    // exams: a paper, ticked, and the clock
    () => P(R(x + 26, y + 6, 72, 104, 5), 'solid') + pen(`M${x + 38} ${y + 30}H${x + 86}M${x + 38} ${y + 50}H${x + 80}M${x + 38} ${y + 70}H${x + 86}`) +
      pen(`M${x + 40} ${y + 88}l6 6 12-12`, 'ac') + pen(C(x + 122, y + 30, 18)) + G('hand', pen(`M${x + 122} ${y + 30}V${y + 18}`)) + pen(`M${x + 122} ${y + 30}H${x + 131}`),
    // our first application: a phone with it on, and a rocket for the launch
    () => P(R(x + 46, y + 2, 58, 108, 10), 'solid') + pen(`M${x + 66} ${y + 12}H${x + 84}`, 'thin') + F(R(x + 56, y + 26, 38, 26, 4), 'ac-fill') +
      pen(`M${x + 56} ${y + 64}H${x + 94}M${x + 56} ${y + 76}H${x + 84}`) +
      G('rocket', pen(`M${x + 128} ${y + 70}c0 -22 8 -34 8 -34s8 12 8 34z`, 'solid') + pen(`M${x + 128} ${y + 64}l-6 10h6M${x + 144} ${y + 64}l6 10h-6`) + `<path class="ac-fill" d="M${x + 132} ${y + 72}h8l-4 12z"/>`),
  ][k]();
  const m = A.moments[k];
  return G(`moment-${k}`, pic + X(cx, y + 144, t(m.label), 14, 'mid bold') + (m.note ? X(cx, y + 162, t(m.note), 13, 'mid t-ac') : ''), `data-x="${r1(cx)}"`);
};
const journey = (narrow: boolean) => {
  const W = narrow ? 520 : 760;
  // the far hills and the clouds, slower than the track
  const farLen = Math.round(WORLD * 0.35 + W);
  let hills = `M0 ${RL - 40}`;
  for (let x = 0; x < farLen; x += 160) hills += `Q${x + 40} ${RL - 40 - 40 - ((x / 160) % 3) * 16} ${x + 80} ${RL - 50}T${x + 160} ${RL - 40}`;
  const far = G('far', pen(hills, 'faint'));
  const clouds = G('clouds', Array.from({ length: Math.ceil((WORLD * 0.15 + 2 * W) / 300) }, (_, i) => cloud(`jcloud-${i}`, 80 + i * 300, 50 + (i % 2) * 34, 0.8 + (i % 2) * 0.3)).join(''));
  const track = coasterTrack();
  // a station at every stop: its platform, its sign (the skill it loads), and a moment of those years over it
  const stations = Array.from({ length: 9 }, (_, k) => {
    const x = stopX(k), platform = P(R(x - 760, RL + 4, 780, 8, 2), 'solid');
    if (k === 8) {
      return G('stop-8', platform + G('station', P(R(x + 40, 312, 210, 84, 4), 'solid') + P(`M${x + 30} 312L${x + 145} 270L${x + 260} 312Z`, 'solid') +
        pen(R(x + 120, 340, 50, 56, 3)) + X(x + 145, 262, t(A.station), 18, 'mid bold')), `data-x="${x}"`);
    }
    const label = k === 0 ? String(A.years[0]) : A.cargo.stops[k - 1], ai = label === 'AI';
    const w = Math.max(70, width(label, 14) + 26);
    const sign = pen(`M${x + 54} ${RL + 34}V${RL - 74}`) + (ai ? `<path class="ac-fill" d="${R(x + 54 - w / 2, RL - 108, w, 34, 6)}"/>` : P(R(x + 54 - w / 2, RL - 108, w, 34, 6), 'solid')) +
      X(x + 54, RL - 86, label, 14, ai ? 'mid mono bold t-inv' : 'mid mono bold');
    return G(`stop-${k}`, platform + sign, `data-x="${x}"`) + journeyMoment(k, x - 370);
  }).join('');
  const near = G('near', [
    pen(`M0 ${RL + 34}H${WORLD}`, 'faint'), pen(track.posts, 'faint thin'),
    `<path class="ties" d="${track.d}"/>`, `<path class="rail" data-p="track" d="${track.d}"/>`,
    pen(track.ai, 'ac thick-ish'), X(track.aiTop[0], track.aiTop[1] - 18, 'AI', 20, 'mid bold t-ac'),
    stations, train(),
  ].join(''));
  return { view: `0 0 ${W} ${J.h}`, inner: clouds + far + near };
};

const SCENES: Record<string, () => { view?: string; inner: string }> = {
  // a dot that becomes a line, under the words, and drops down to start the journey
  intro: () => ({ view: '0 0 800 220', inner: [
    `<circle data-p="dot" class="fill-ink" cx="400" cy="40" r="6"/>`,
    G('under', P('M400 40H90') + P('M400 40H710')),
    G('drop', P('M400 40V220')),
  ].join('') }),

  // Chania's old harbour, from the photographs: the Venetian building on the quay, its lamps and passers-by,
  // boats on the moving water, the lighthouse on its fort sweeping its light. Then the university: the round
  // courtyard of the ECE building, stone wall, tall slit windows, its amphitheatre, and its students cheering
  chania: () => {
    // the sea, its rows of waves smaller towards the horizon
    const waves = [[206, 1.2, 36], [222, 1.6, 42], [244, 2.2, 50], [272, 3, 58], [308, 3.8, 66], [352, 4.6, 76], [404, 5.6, 88], [460, 6.4, 98]].map(([y, a, per], i) => {
      let d = `M${-per * 2} ${y}`;
      for (let x = -per * 2; x < 900; x += per) d += `q${per / 4} ${-a} ${per / 2} 0t${per / 2} 0`;
      return G(`wave-${i}`, pen(d, i < 3 ? 'faint wave' : i === 4 || i === 6 ? 'ac wave' : 'wave'), `data-per="${per}"`);
    }).join('');
    // the Venetian building, an isometric block under a hipped roof of tiles, a flag on top
    const venetian = (() => {
      const x = 120, y = 336, w = 176, d = 52, h = 104, c = 0.866, sn = 0.5;
      const fr = [x, y - h], rt = [x + w * c, y - w * sn - h], lf = [x - d * c, y - d * sn - h], bk = [x + w * c - d * c, y - w * sn - d * sn - h];
      const mid = (a: N[], b: N[]) => [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
      const inw = (q: N[], k: N) => [q[0] + k * c, q[1] - k * sn - 26];
      const r1p = inw(mid(fr, lf), d / 2), r2p = inw(mid(rt, bk), -d / 2);
      return block('venetian', x, y, w, d, h, 2, 6) +
        G('roof', F(poly([fr, rt, r2p, r1p]), 'roof') + F(poly([lf, fr, r1p]), 'face-r') + pen(poly([fr, rt, r2p, r1p])) + pen(poly([lf, fr, r1p])) + pen(`M${r1(r2p[0])} ${r1(r2p[1])}L${r1(bk[0])} ${r1(bk[1])}L${r1(rt[0])} ${r1(rt[1])}`, 'thin')) +
        G('flag', pen(`M${r1(r1p[0] + 18)} ${r1(r1p[1] - 9)}V${r1(r1p[1] - 52)}`) + `<path class="ac-fill" d="M${r1(r1p[0] + 18)} ${r1(r1p[1] - 52)}h22l-5 7 5 7h-22z"/>`);
    })();
    // the quay along it, curving out into the harbour, with its lamps and passers-by
    const quay = 'M30 486Q170 400 372 288';
    const lamps = [0.22, 0.42, 0.62, 0.82].map((t, i) => {
      const x = r1((1 - t) * (1 - t) * 30 + 2 * t * (1 - t) * 170 + t * t * 372), y = r1((1 - t) * (1 - t) * 486 + 2 * t * (1 - t) * 400 + t * t * 288);
      const hgt = 44 - i * 6;
      return pen(`M${x} ${y}V${y - hgt}`) + pen(C(x, y - hgt - 4, 4)) + pen(`M${x - 6} ${y}H${x + 6}`, 'thin');
    }).join('');
    // the lighthouse on its fort, at the end of the breakwater
    const lighthouse = [
      block('fort', 642, 262, 72, 42, 30), pen('M618 220v-6h8v6M634 212v-6h8v6M690 196v-6h8v6M706 188v-6h8v6', 'thin'),
      `<path class="face-r" d="M655 202L662 98H670L668 202Z"/>`,
      pen('M640 204L648 98M670 202L664 98'), pen('M641 176Q655 182 669 175M643 148Q655 154 667 147M645 122Q655 128 665 121', 'thin'),
      pen('M638 98H674'), pen('M641 98V90M647 98V90M653 98V90M659 98V90M665 98V90M671 98V90', 'thin'), pen('M638 90H674'),
      P(R(646, 66, 20, 24, 3), 'solid'), pen('M652 66V90M660 66V90', 'thin'), pen('M643 66C643 50 669 50 669 66'), pen('M656 54V44'),
    ].join('');
    // the university's round courtyard: the curve of its wall, as the photographs show it
    // (each edge a quadratic curve: y = y0 + 2 (cy - y0) t (1 - t), with its control point cy in the middle)
    const rimY = (t: N) => 70 + 160 * t * (1 - t), bandY = (t: N) => 244 + 108 * t * (1 - t), floorY = (t: N) => 352 + 120 * t * (1 - t);
    const slits = Array.from({ length: 11 }, (_, i) => {
      const t = 0.06 + i * 0.088, x = r1(40 + 720 * t), top = r1(rimY(t) + 24), bot = r1(bandY(t) - 30), wd = r1(4 + 5 * Math.sin(Math.PI * t));
      return `<rect class="slit" x="${x - wd / 2}" y="${top}" width="${wd}" height="${bot - top}" rx="1"/>`;
    }).join('');
    const lows = Array.from({ length: 10 }, (_, i) => {
      const t = 0.1 + i * 0.09, x = r1(40 + 720 * t), top = r1(bandY(t) + 20), bot = r1(floorY(t) - 12), wd = r1(20 + 18 * Math.sin(Math.PI * t));
      return `<rect class="pane" x="${r1(x - wd / 2)}" y="${top}" width="${wd}" height="${r1(bot - top)}" rx="2"/>`;
    }).join('');
    const crowd = [
      ...Array.from({ length: 9 }, (_, i) => [262 + i * 34, 452, 0.95]),
      ...Array.from({ length: 8 }, (_, i) => [279 + i * 34, 486, 1.12]),
    ].map(([x, y, sc], i) => cheer(`fan-${i}`, x, y, sc, i === 12 ? 'ac' : '')).join('');
    return { inner: [
      `<defs><clipPath id="ms-sea"><path d="M30 486Q170 400 372 288L392 196H800V500H30Z"/></clipPath></defs>`,
      G('lead', pen('M0 486C10 486 20 486 30 486')),
      G('harbour', [
        cloud('cloud-0', 420, 70, 1), cloud('cloud-1', 560, 120, 0.7), cloud('cloud-2', 250, 40, 0.8),
        pen('M392 196H800', 'faint'),
        `<g clip-path="url(#ms-sea)">` + `<path class="sea" data-p="sea" d="M0 190H800V500H0Z"/>` + waves +
          G('sail', pen('M452 232H492L486 240H458Z', 'solid') + pen('M472 232V160') + pen('M472 164L496 228H472', 'solid')) +
          G('dinghies', [0, 1, 2, 3, 4].map((k) => pen(`M${520 + k * 22} 236L${528 + k * 22} 216V236Z`, 'solid')).join('')) +
          G('breakwater', pen('M580 262L800 248', 'thick-ish')) + `</g>`,
        G('lighthouse', lighthouse),
        venetian,
        pen(quay), pen('M30 500Q190 410 402 292', 'thin'),
        G('lamps', lamps),
        walker('walker-0', 168, 438, 0.5), walker('walker-1', 236, 404, 0.45), walker('walker-2', 300, 360, 0.4, 'ac'),
        written('chania-name', 52, 104, t(A.chania.city), 72, 'script'),
      ].join('')),
      G('beam-r', `<path class="beam" d="M660 78L812 54V104Z"/>`),
      G('beam-l', `<path class="beam" d="M652 78L500 56V102Z"/>`),
      G('campus', [
        cloud('ccloud-0', 690, 34, 0.8), cloud('ccloud-1', 96, 22, 0.6),
        // the wing (a nod to the university's emblem) and the university's name beside it, as its sign
        G('wing', pen('M372 58C378 38 402 24 434 24C428 30 428 32 440 34C432 40 430 42 442 46C432 50 426 52 434 56C418 60 394 56 372 58Z', 'ac') +
          pen('M384 54C394 44 410 38 428 34M390 56C402 50 416 46 432 44', 'ac thin'), 'transform="translate(-206 0)"'),
        written('campus-name', 250, 52, t(A.chania.campus), 26, 'bold'),
        F(`M40 70Q400 230 760 70V352Q400 592 40 352Z`, 'stone'),
        pen('M40 70Q400 230 760 70'), pen('M40 70V352M760 70V352'),
        slits,
        pen('M40 244Q400 460 760 244', 'thick-ish'), pen('M40 251Q400 467 760 251', 'thin'),
        lows,
        pen('M40 352Q400 592 760 352'),
        // the amphitheatre's railings either side of the courtyard
        G('steps', pen('M150 380Q170 440 210 500M650 380Q630 440 590 500') + pen('M140 372Q160 436 198 500M660 372Q640 436 602 500', 'thin')),
      ].join(''), 'opacity="0"'),
      G('crowd', crowd, 'opacity="0"'),
    ].join('') };
  },

  // the diploma: the questionnaire it builds, on a restaurant's tablet; then fireworks, and a cap in the air
  graduation: () => ({ inner: [
    G('lead', pen('M0 250C20 250 40 250 60 250')),
    G('tablet', P(R(60, 60, 270, 360, 22), 'solid') + pen(R(76, 80, 238, 320, 8), 'thin') +
      // the restaurant's awning over its questionnaire
      pen('M96 100H294') + [0, 1, 2, 3, 4, 5].map((i) => `<path class="${i % 2 ? 'face-r' : 'ac-fill'}" d="M${96 + i * 33} 100h33v18q-16.5 12 -33 0z"/>`).join('') +
      X(195, 160, t(A.graduation.question), 16, 'mid bold') +
      [0, 1, 2, 3, 4].map((i) => {
        const cx = 135 + i * 30, cy = 196, r = 11;
        return `<path class="${i < 4 ? 'ac-fill' : 'star-off'}" data-p="star-${i}" d="${'M' + Array.from({ length: 10 }, (_, k) => { const a = -Math.PI / 2 + (k * Math.PI) / 5, q = k % 2 ? r * 0.45 : r; return `${r1(cx + q * Math.cos(a))} ${r1(cy + q * Math.sin(a))}`; }).join('L') + 'Z'}"/>`;
      }).join('') +
      [0, 1].map((i) => pen(R(104, 236 + i * 40, 18, 18, 4)) + pen(`M134 ${245 + i * 40}H${i ? 250 : 270}`)).join('') +
      pen('M108 245l4 4 7-8', 'ac') +
      `<path class="ac-fill" d="${R(140, 336, 110, 36, 18)}"/>` + X(195, 360, t(A.graduation.send), 15, 'mid bold t-inv')),
    G('app', X(195, 452, A.graduation.app, 17, 'mid bold')),
    G('grad', person(590, 270, 1.6) + pen('M560 362L548 308') + pen('M620 362L634 312') + P(R(632, 296, 40, 16, 6), 'solid') + `<path class="ac-fill" d="M648 296h8v16h-8z"/>`),
    written('grad-name', 590, 424, t(A.graduation.graduated), 56, 'script mid'),
    G('degree', X(590, 456, t(A.graduation.degree), 14, 'mid')),
    G('cap', `<path class="fill-ink" d="M548 240L590 222L632 240L590 258Z"/>` + pen('M566 248V262C578 270 602 270 614 262V248') + pen('M624 243V266', 'ac') + `<circle class="ac-fill" cx="624" cy="268" r="4"/>`),
    burst('fw-0', 470, 110, 46), burst('fw-1', 660, 80, 56), burst('fw-2', 750, 200, 40),
    G('confetti', [[440, 200], [520, 60], [600, 140], [700, 130], [760, 290], [470, 300], [560, 40]].map(([x, y], i) =>
      `<rect class="${i % 2 ? 'ac-fill' : 'fill-ink'}" x="${x}" y="${y}" width="8" height="5" rx="1" transform="rotate(${i * 37} ${x} ${y})"/>`).join('')),
  ].join('') }),

  // websites stack up; a shop fills and feeds the marketplaces
  reach: () => ({ inner: [
    G('lead', P('M0 250C20 250 30 250 40 250')),
    [0, 1, 2].map((i) => G(`browser-${i}`, P(R(40 + i * 34, 60 + i * 30, 300, 200, 10), 'solid') + P(`M${40 + i * 34} ${92 + i * 30}H${340 + i * 34}`) +
      D(58 + i * 34, 76 + i * 30, 3.5) + D(70 + i * 34, 76 + i * 30, 3.5) + D(82 + i * 34, 76 + i * 30, 3.5) +
      P(`M${62 + i * 34} ${118 + i * 30}H${200 + i * 34}`, 'thick') + P(`M${62 + i * 34} ${146 + i * 30}H${300 + i * 34}M${62 + i * 34} ${166 + i * 30}H${260 + i * 34}`))).join(''),
    G('cart', P('M430 200H560L544 290H448Z', 'solid') + P('M430 200L418 176H398') + P(C(458, 312, 10)) + P(C(534, 312, 10))),
    [[452, 214, 26, 26], [484, 206, 26, 34], [516, 218, 22, 22]].map(([x, y, w, h], i) => G(`product-${i}`, P(R(x, y, w, h, 4), 'solid ac'))).join(''),
    A.reach.markets.map((m, i) => G(`market-${i}`, P(R(640, 90 + i * 110, 130, 54, 10), 'solid') + X(705, 123 + i * 110, m, 18, 'mid bold'))).join(''),
    [117, 227, 337].map((y, i) => G(`feed-${i}`, P(`M562 230C604 230 600 ${y} 632 ${y}`, 'ac') + P(`M624 ${y - 6}L634 ${y}L624 ${y + 6}`, 'ac'))).join(''),
    G('xml', X(596, 214, A.reach.feed, 15, 'mono t-ac mid')),
  ].join('') }),

  // a desk, books and a laptop; the cobalt peak of the courses comes back, with what it holds now
  ai: () => ({ inner: [
    G('lead', P('M0 380C40 380 80 380 120 380')),
    G('desk', P('M120 380H560') + P('M150 380V470M530 380V470') + P(R(160, 350, 90, 30, 3)) + P(R(170, 322, 74, 28, 3)) + P(R(166, 298, 82, 24, 3))),
    G('reader', person(380, 230, 1.5)),
    G('laptop', P('M300 380L316 290H444L460 380Z', 'solid') + P('M330 312H430', 'faint')),
    G('peak', P('M560 320L650 150L740 320', 'ac thick') + X(650, 132, 'AI', 26, 'mid bold t-ac')),
    A.ai.map((a, i) => G(`ai-${i}`, pill([560, 690, 700, 540][i], [70, 60, 200, 210][i], a, 16, i % 2 ? 'ac' : ''))).join(''),
  ].join('') }),

  // the cobalt line that ran beside it all comes forward; its dots open into the work built along the way
  side: () => ({ inner: [
    G('lead', pen('M0 250C40 250 60 250 80 250')),
    `<path class="ac thick sa-d" data-p="line" pathLength="1" d="M80 250C200 180 300 320 420 250C540 180 640 320 790 250"/>`,
    A.side.map((s, i) => {
      const x = [260, 580][i], y = [216, 284][i], up = i === 0;
      const by = up ? y - 120 : y + 40;
      return `<circle class="ac-fill" data-p="sdot-${i}" cx="${x}" cy="${y}" r="9"/>` +
        G(`scard-${i}`, pen(`M${x} ${y + (up ? -12 : 12)}V${up ? by + 64 : by}`, 'ac') + P(R(x - 120, by, 240, 64, 10), 'solid ac') + X(x, by + 38, s.name.split(' · ')[0], 17, 'mid bold'));
    }).join(''),
  ].join('') }),

  // the two lines meet and, as one, draw an engineer's brackets, a team, and a maze with its way out
  today: () => ({ inner: [
    G('lead', P('M0 220C80 220 120 240 200 250') + P('M0 280C80 280 120 260 200 250', 'ac')),
    G('one', P('M200 250H270')),
    G('code', P('M318 206L278 250L318 294') + P('M360 196L336 304') + P('M378 206L418 250L378 294')),
    G('link-1', P('M418 250H470')),
    G('team', person(500, 214, 0.9) + person(560, 200, 1.1) + person(620, 214, 0.9)),
    G('link-2', P('M650 250H660')),
    G('maze', P(R(660, 190, 120, 120, 4)) + P('M660 220H720M690 220V250M720 250H780M690 280H750M660 280V280M720 190V220M750 250V310')),
    G('way', P('M662 205H705V235H735V265H765V295H778', 'ac thick')),
    A.roles.map((r, i) => X([348, 560, 720][i], 360, t(r), 18, 'mid bold', `data-p="role-${i}"`)).join(''),
  ].join('') }),
};

const scene: { view?: string; inner: string } = name === 'journey-wide' ? journey(false) : name === 'journey-narrow' ? journey(true)
  : name === 'kalimera' ? { view: `0 0 ${KC.w} ${KC.h}`, inner: kalimeraArt() }
  : name === 'koan' ? { view: `0 0 ${KO.w} ${KO.h}`, inner: koanArt() }
  : name === 'deindeal' ? { view: `0 0 ${DD.w} ${DD.h}`, inner: deindealArt() } : SCENES[name]();
const view = scene.view ?? '0 0 800 500';
---
<svg class:list={['ms-svg', `art-${name}`]} data-art={name} data-world={name.startsWith('journey') ? WORLD : undefined} viewBox={view} aria-hidden="true" focusable="false"
  data-sun={name === 'kalimera' ? SUN.flat().join(',') : undefined}
  preserveAspectRatio={name.startsWith('journey') ? 'xMidYMid slice' : name === 'kalimera' ? 'xMidYMax meet' : 'xMidYMid meet'} set:html={scene.inner} />

<style>
  @font-face { font-family: 'Great Vibes'; src: url('/fonts/great-vibes-latin-400.woff2') format('woff2'); font-weight: 400; font-display: swap; }
  .ms-svg { display: block; width: 100%; height: 100%; overflow: visible; color: var(--ink); }
  /* the line widths, times --sw: the journey sets it as its camera pulls back, so its lines thin less than it shrinks */
  .ms-svg :global(path), .ms-svg :global(rect) { fill: none; stroke: currentColor; stroke-width: calc(2.4px * var(--sw, 1)); stroke-linecap: round; stroke-linejoin: round; }
  .ms-svg :global(.sa-d) { stroke-dasharray: 1 2; }
  .ms-svg :global(.thick) { stroke-width: calc(6px * var(--sw, 1)); }
  .ms-svg :global(.thick-ish) { stroke-width: calc(4px * var(--sw, 1)); }
  .ms-svg :global(.faint) { stroke: color-mix(in srgb, currentColor 30%, transparent); }
  .ms-svg :global(.ac) { stroke: var(--cobalt); }
  .ms-svg :global(.solid) { fill: var(--paper); }
  /* depth: the soft shadow a solid shape casts, and the three faces of a block */
  .ms-svg :global(.shade) { fill: rgb(20 20 20 / 0.08); stroke: none; }
  .ms-svg :global(.face-t) { fill: var(--paper); stroke: none; }
  .ms-svg :global(.face-l) { fill: color-mix(in srgb, var(--ink) 7%, var(--paper)); stroke: none; }
  .ms-svg :global(.face-r) { fill: color-mix(in srgb, var(--ink) 15%, var(--paper)); stroke: none; }
  .ms-svg :global(.thin) { stroke-width: calc(1.4px * var(--sw, 1)); }
  .ms-svg :global(.wave) { stroke-width: calc(2px * var(--sw, 1)); }
  .ms-svg :global(.beam) { fill: var(--cobalt); opacity: 0.18; stroke: none; }
  .ms-svg :global(.star-off) { fill: color-mix(in srgb, var(--ink) 18%, transparent); stroke: none; }
  .ms-svg :global(.t-inv) { fill: var(--paper); }
  /* the journey */
  .art-journey-wide, .art-journey-narrow { overflow: hidden; }
  .ms-svg :global(.ties) { stroke-width: 11; stroke-dasharray: 3 11; stroke-linecap: butt; stroke: color-mix(in srgb, var(--ink) 45%, transparent); }
  .ms-svg :global(.rail) { stroke-width: calc(4px * var(--sw, 1)); }
  /* a skill waits at its station until the train has reached it, then drops into its wagon */
  .ms-svg :global([data-at]) { transition: opacity 0.25s ease, translate 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); }
  :global(html.js) .ms-svg :global([data-at]:not([data-at='0']):not(.loaded)) { opacity: 0; translate: 0 -90px; }
  .ms-svg :global(.rod) { stroke-width: calc(3px * var(--sw, 1)); }
  .ms-svg :global(.puff) { fill: var(--paper); stroke: color-mix(in srgb, var(--ink) 45%, transparent); stroke-width: calc(1.6px * var(--sw, 1)); }
  .ms-svg :global(.glow) { fill: color-mix(in srgb, var(--cobalt) 30%, var(--paper)); stroke: currentColor; stroke-width: calc(1.6px * var(--sw, 1)); }
  .ms-svg :global(.bubble) { fill: var(--paper); stroke: var(--cobalt); stroke-width: calc(1.4px * var(--sw, 1)); }
  .ms-svg :global(.ai-hill) { fill: color-mix(in srgb, var(--cobalt) 12%, var(--paper)); stroke: none; }
  .ms-svg :global(.note) { fill: color-mix(in srgb, var(--ink) 14%, var(--paper)); stroke: none; }
  .ms-svg :global(.ac-note) { fill: color-mix(in srgb, var(--cobalt) 35%, var(--paper)); }
  .ms-svg :global(.roof) { fill: color-mix(in srgb, var(--cobalt) 22%, var(--paper)); stroke: none; }
  .ms-svg :global(.stone) { fill: color-mix(in srgb, var(--ink) 6%, var(--paper)); stroke: none; }
  .ms-svg :global(.slit) { fill: color-mix(in srgb, var(--cobalt) 30%, var(--ink)); stroke: none; opacity: 0.75; }
  .ms-svg :global(.pane) { fill: color-mix(in srgb, var(--ink) 42%, var(--paper)); stroke: none; }
  .ms-svg :global(.fill-ink) { fill: currentColor; stroke: none; }
  .ms-svg :global(.ac-fill) { fill: var(--cobalt); stroke: none; }
  .ms-svg :global(circle) { fill: currentColor; }
  .ms-svg :global(.stop) { fill: color-mix(in srgb, currentColor 35%, transparent); }
  .ms-svg :global(.stop.ac-fill) { fill: var(--cobalt); }
  .ms-svg :global(.stop.passed) { fill: currentColor; }
  .ms-svg :global(.net) { stroke-dasharray: 6 8; }
  .ms-svg :global(.track) { stroke-width: calc(4px * var(--sw, 1)); }
  .ms-svg :global(.t) { fill: currentColor; stroke: none; font-weight: 500; }
  .ms-svg :global(.mid) { text-anchor: middle; }
  .ms-svg :global(.bold) { font-weight: 700; }
  .ms-svg :global(.t-ac) { fill: var(--cobalt); }
  .ms-svg :global(.muted) { fill: color-mix(in srgb, currentColor 55%, transparent); }
  .ms-svg :global(.mono) { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  /* words by hand (the city names, the graduation): Great Vibes, OFL, in public/fonts with its licence */
  .ms-svg :global(.script) { font-family: 'Great Vibes', 'Snell Roundhand', 'Segoe Script', cursive; font-weight: 400; }
  .ms-svg :global(.sea) { fill: color-mix(in srgb, var(--cobalt) 9%, var(--paper)); stroke: none; }
  .ms-svg :global(.math) { font-family: Georgia, 'Times New Roman', serif; font-style: italic; }
  /* the Kalimera chapter: the sun's soft disc and the way it has come, where it was heading before the pivot, the
     app's sun on its cobalt header, shop awnings, the pivot's highlights and its light, Athens through the door */
  .ms-svg :global(.kc-disc) { fill: color-mix(in srgb, var(--cobalt) 14%, var(--paper)); stroke: none; }
  .ms-svg :global(.kc-trail) { fill: none; stroke: color-mix(in srgb, var(--cobalt) 40%, transparent); stroke-width: 2; stroke-linecap: round; }
  .ms-svg :global(.kc-ghost) { stroke: color-mix(in srgb, var(--cobalt) 40%, transparent); }
  .ms-svg :global(.kc-inv) { fill: var(--paper); }
  .ms-svg :global(.kc-awn) { fill: color-mix(in srgb, var(--ink) 14%, var(--paper)); stroke: none; }
  .ms-svg :global(.kc-hi) { fill: color-mix(in srgb, var(--cobalt) 14%, var(--paper)); stroke: none; }
  .ms-svg :global(.kc-glow) { fill: color-mix(in srgb, var(--cobalt) 24%, transparent); stroke: none; }
  .ms-svg :global(.kc-view) { fill: color-mix(in srgb, var(--cobalt) 10%, var(--paper)); stroke: none; }
  /* the KOAN chapter's map: Europe's markets as dots, the dotted lines of the mandate, the light running along the
     route from the UK */
  .ms-svg :global(.ko-market) { fill: color-mix(in srgb, var(--ink) 35%, transparent); }
  .ms-svg :global(.ko-dot) { fill: var(--ink); }
  .ms-svg :global(.ko-pulse) { fill: none; stroke: var(--cobalt); stroke-width: calc(5px * var(--sw, 1)); stroke-linecap: round; stroke-dasharray: 0.06 1; opacity: 0; }
  /* the DeinDeal chapter: the pipes of the integrations (ink, hollow), a format's name over its pipe, a field
     broken before it is fixed, where a dataset drops, the glow of the gear that becomes Feedgenix; a phone shows
     fewer cards in the flood */
  .ms-svg :global(.dd-pipe) { stroke-width: calc(9px * var(--sw, 1)); }
  .ms-svg :global(.dd-pipe-in) { stroke: var(--paper); stroke-width: calc(4.5px * var(--sw, 1)); }
  .ms-svg :global(.dd-halo) { paint-order: stroke; stroke: var(--paper); stroke-width: 5px; stroke-linejoin: round; }
  .ms-svg :global(.dd-broken) { stroke-dasharray: 3 5; stroke: color-mix(in srgb, var(--ink) 55%, transparent); }
  .ms-svg :global(.dd-drop) { stroke-dasharray: 6 5; }
  .ms-svg :global(.dd-glow) { fill: color-mix(in srgb, var(--cobalt) 22%, transparent); stroke: none; }
  :global(.ch.phone) .art-deindeal :global(.dd-more) { display: none; }
  /* a wide screen sets the accelerator's cards side by side, a phone one under another */
  .art-kalimera :global([data-p='kc-narrow']) { display: none; }
  :global(.ch.phone) .art-kalimera :global([data-p='kc-narrow']) { display: inline; }
  :global(.ch.phone) .art-kalimera :global([data-p='kc-wide']), :global(.ch.phone) .art-kalimera :global(.kc-more) { display: none; }
  /* a phone: the picture shows at under half its size; the words that have room grow, so they still read (the
     rest of what a scene says is in its own words, beside it) */
  @media (max-width: 760px) {
    .art-firstyear :global(.math) { font-size: 28px; }
    .ms-svg :global([data-count]) { font-size: 48px; }
    .art-graduation :global([data-p='degree'] text) { font-size: 18px; }
    /* the theory tags are listed under the words instead */
    .art-postgres :global([data-p^='tag-']) { display: none; }
  }
</style>
