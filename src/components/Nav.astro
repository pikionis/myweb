---
import { pages } from '../data/site';
import Logo from './Logo.astro';

// the split sits on the page you are on (src/scripts/splitnav.ts)
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
// the longest matching path wins, so /projects/arangia lights "Projects"
const current = pages.findIndex(({ href }) => href === here || (href !== '/' && here.startsWith(`${href}/`)));
// pages that open on a dark field (the home hero, the contact page) start with the dark bar, before any script runs
const dark = here === '/' || here === '/contact';
---
<header class:list={['topbar', { 'on-dark': dark }]}>
  <Logo />
  <nav aria-label="Main" class="split" data-split>
    <div class="row">
      {pages.map(({ href, name, short }, i) => (
        <div class:list={['seg', { on: i === current, pinned: i === current, 'home-seg': href === '/' }]}>
          <a class="link" href={href} draggable="false" aria-current={i === current ? 'page' : undefined} aria-label={short ? name : undefined}>
            {i > 0 && <span class="cap l" aria-hidden="true"></span>}
            {i < pages.length - 1 && <span class="cap r" aria-hidden="true"></span>}
            <!-- a phone shows the short name, drawn in CSS, so the page's text holds each name once -->
            <span class="label" data-short={short}><span class="long">{name}</span></span>
            <span class="tick" aria-hidden="true"></span>
          </a>
        </div>
      ))}
    </div>
  </nav>
</header>

<style>
  .topbar {
    position: fixed; inset: 0 0 auto 0; z-index: 50; pointer-events: none;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    min-height: var(--topbar-h);
    padding: calc(16px + env(safe-area-inset-top, 0px)) max(20px, env(safe-area-inset-right, 0px)) 16px max(20px, env(safe-area-inset-left, 0px));
    --logo-ink: var(--ink);
    /* the bar takes the colour of the ground under it, so it reads as no bar, yet text never runs under the logo */
    background: var(--paper); transition: background-color 0.3s ease;
  }
  /* the logo and the bar follow the ground; the menu keeps one look everywhere */
  .topbar.on-dark { --logo-ink: var(--ivory); background: #0a0b0a; }

  /* the logo holds the top-left corner, the menu the top right; the split opens up to 8px each side of
     the active link, so it keeps that much room on both sides */
  .split { pointer-events: auto; margin-left: auto; margin-right: 8px; }
  .row { position: relative; display: flex; align-items: center; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .seg { position: relative; z-index: 10; }
  .seg.pinned { z-index: 20; }
  .link {
    position: relative; display: flex; align-items: center; height: 36px; padding: 0 16px; border-radius: 12px;
    background: #141414; color: #a1a1aa;
    font-size: 0.875rem; font-weight: 500; text-decoration: none; outline: none;
    transition: color 0.15s ease;
  }
  .link:focus-visible { box-shadow: inset 0 0 0 2px var(--accent); }
  @media (hover: hover) and (pointer: fine) { .link:hover { color: #f4f4f5; } }
  .seg.on .link { color: #ffffff; }
  .label { position: relative; white-space: nowrap; }
  /* square patches hide the rounded corners while a neighbour touches */
  .cap { position: absolute; top: 0; bottom: 0; width: 12px; background: #141414; }
  .cap.l { left: -1px; transform-origin: left; }
  .cap.r { right: -1px; transform-origin: right; }
  .tick {
    position: absolute; bottom: 6px; left: 50%; width: 12px; height: 2px; margin-left: -6px; border-radius: 2px;
    background: var(--accent); transform: scaleX(0); transition: transform 0.2s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .seg.on .tick { transform: scaleX(1); }

  @media (prefers-reduced-motion: reduce) { .tick { transition: none; } }
  /* a phone: the logo keeps the top, and the menu floats at the bottom, where the thumb is; the logo
     stands in for Home */
  @media (max-width: 820px) {
    .split {
      position: fixed; left: 0; right: 0; bottom: max(14px, env(safe-area-inset-bottom, 0px)); margin: 0;
      display: flex; justify-content: center; pointer-events: none;
    }
    .row { pointer-events: auto; }
    .home-seg { display: none; }
    .link {
      height: 48px; padding: 0 12px; font-size: 0.8125rem;
      /* it floats over whatever is under it, light or dark: a hairline and a soft shadow keep it apart */
      box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.07), 0 14px 30px -12px rgb(0 0 0 / 0.55);
    }
    [data-short] .long { display: none; }
    [data-short]::after { content: attr(data-short); }
  }
  @media (max-width: 420px) {
    .topbar { padding-inline: max(16px, env(safe-area-inset-left, 0px)) max(16px, env(safe-area-inset-right, 0px)); }
    .link { padding: 0 10px; }
  }
  @media (max-width: 380px) { .link { padding: 0 8px; font-size: 0.78rem; } }
</style>
