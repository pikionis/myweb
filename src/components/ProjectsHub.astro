---
// /projects and /projects/<id>: every project in a panel at the top, and the one picked under it: how fast its site
// loads (PageSpeed, on a phone and on a desktop), what it is built with, its story, and the site itself in a frame.
// Every project is on every page, so picking one is instant (src/scripts/projects.ts); each page opens on its own
// project, and without script the panel's links simply go to each project's page.
import { render } from 'astro:content';
import LivePreview from './LivePreview.astro';
import { projectsInOrder, projectHref, visitUrl, badgeOf, hasStory, type ProjectEntry } from '../data/projects';
import { services, serviceColors, ui, person } from '../data/site';
import pagespeed from '../data/pagespeed.json';

interface Props { selected?: string }

type Metric = 'fcp' | 'lcp' | 'tbt' | 'cls' | 'si';
type Run = {
  source: 'pagespeed' | 'lighthouse'; at: string;
  scores: Record<keyof typeof ui.projectsPage.scores, number>;
  lab: Record<Metric, { v: number; s: number }>;
  field?: Partial<Record<'lcp' | 'inp' | 'cls' | 'fcp' | 'ttfb', { p75: number; category: string }>>;
};
const speed = pagespeed as Record<string, { url: string; mobile?: Run; desktop?: Run }>;

const all = await projectsInOrder();
const selected = Astro.props.selected ?? all[0].id;
const t = ui.projectsPage;
const stories = new Map(await Promise.all(all.filter(hasStory).map(async (p) => [p.id, (await render(p)).Content] as const)));

const titleOf = (k: string) => services.find((s) => s.key === k)?.title ?? k;
/** What kind of work it is: its services, or its first tag. */
const kindOf = (p: ProjectEntry) => (p.data.services.length ? p.data.services.map(titleOf).join(', ') : p.data.tags[0] ?? '');
const colours = (p: ProjectEntry) => serviceColors[p.data.services[0] ?? 'none'];
const host = (u: string) => new URL(u).host.replace(/^www\./, '');

// how PageSpeed colours a score (0–100), a lab metric (its score, 0–1) and a field metric (CrUX's verdict)
const byScore = (n: number) => (n >= 90 ? 'good' : n >= 50 ? 'average' : 'poor');
const byCrux = (c: string) => (c === 'FAST' ? 'good' : c === 'AVERAGE' ? 'average' : 'poor');
const shown = (k: string, v: number) =>
  k === 'cls' ? String(Number(v.toFixed(3))) : v >= 1000 ? `${(v / 1000).toFixed(1)} s` : `${Math.round(v)} ms`;
const day = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const report = (url: string, run: 'mobile' | 'desktop') =>
  `https://pagespeed.web.dev/report?url=${encodeURIComponent(url)}&form_factor=${run}`;
const RUNS = [['mobile', t.phone], ['desktop', t.desktop]] as const;
const LAB: Metric[] = ['lcp', 'fcp', 'tbt', 'cls', 'si'];
// a site's results show only while they are all green, on a phone and on a desktop: every score 90 or more, every
// vital (and real visitors' data, where Google has it) good. Below that the site is being worked on and shows none,
// never a number other than the one measured.
const green = (r?: Run) => !!r
  && Object.values(r.scores).every((n) => n >= 90)
  && LAB.every((k) => r.lab[k].s >= 0.9)
  && Object.values(r.field ?? {}).every((m) => typeof m !== 'object' || byCrux(m.category) === 'good');
const publish = (id: string) => green(speed[id]?.mobile) && green(speed[id]?.desktop);

const arrow = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>';
const next = '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';
const back = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>';
const on = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>';
const expand = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7" /></svg>';
---
<main class="hub theme-light" data-hub data-suffix={person.name}>
  <!-- every project: pick one -->
  <section class="panel" aria-labelledby="hub-title">
    <div class="pn-head">
      <h1 id="hub-title">{t.title}</h1>
      <p class="pn-lede">{all.length} {t.lede}</p>
      <div class="pn-nav" aria-hidden="true">
        <button type="button" class="pn-step" data-step="-1" tabindex="-1" aria-label={t.previous}><Fragment set:html={back} /></button>
        <button type="button" class="pn-step" data-step="1" tabindex="-1" aria-label={t.more}><Fragment set:html={on} /></button>
      </div>
    </div>
    <ul class="rail" data-rail>
      {all.map((p, i) => {
        const [bg, fg] = colours(p);
        return (
          <li>
            <a class="tile" href={projectHref(p)} data-pick={p.id} aria-current={p.id === selected ? 'page' : undefined}>
              <span class="t-pic" style={`--bg: ${bg}; --fg: ${fg}`}>
                {p.data.cover ? (
                  <img src={p.data.cover} alt="" width="800" loading={i < 3 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
                ) : p.data.metric ? (
                  <span class="t-card"><b>{p.data.metric.value}</b><span>{p.data.metric.label}</span></span>
                ) : (
                  <span class="t-card"><b class="t-word">{p.data.title}</b></span>
                )}
              </span>
              <span class="t-name">{p.data.title}</span>
              <span class="t-kind">{badgeOf(p) ?? kindOf(p)}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- the project picked: one is shown, the rest wait hidden -->
  {all.map((p, i) => {
    const run = publish(p.id) ? speed[p.id] : undefined;
    const live = !p.data.launching && p.data.live_url;
    const visit = visitUrl(p);
    const Content = stories.get(p.id);
    const following = all[(i + 1) % all.length];
    const [bg, fg] = colours(p);
    const badge = badgeOf(p);
    return (
      <article class="proj wrap" data-proj={p.id} data-title={p.data.title} data-href={projectHref(p)} hidden={p.id !== selected} aria-labelledby={`pt-${p.id}`}>
        <header class="p-head" data-in>
          <h2 class="p-title" id={`pt-${p.id}`}>{p.data.title}</h2>
          <p class="p-summary">{p.data.summary}</p>
          <div class="p-meta">
            <span class="p-kind">{kindOf(p)}</span>
            {badge && <span class="p-badge">{badge}</span>}
            {visit && <a class="p-visit" href={visit} target="_blank" rel="noopener">{ui.visitSite}<Fragment set:html={arrow} /></a>}
          </div>
        </header>

        {live && run && (
          <section class="p-speed" data-in data-speed aria-labelledby={`ps-${p.id}`}>
            <div class="s-head">
              <h3 id={`ps-${p.id}`}>{t.speed}</h3>
              <div class="s-switch" role="group" aria-label={t.viewAs} data-switch>
                <button type="button" data-mode="phone" aria-pressed="false">{t.phone}</button>
                <button type="button" data-mode="desktop" aria-pressed="false">{t.desktop}</button>
              </div>
            </div>
            {RUNS.map(([key, device]) => {
              const r = run[key];
              if (!r) return null;
              return (
                <div class="s-run" data-run={key}>
                  <h4 class="s-device">{device}</h4>
                  <ul class="s-scores">
                    {(Object.keys(t.scores) as (keyof typeof t.scores)[]).map((c) => (
                      <li class="dial" data-v={byScore(r.scores[c])}>
                        <span class="d-ring">
                          <svg viewBox="0 0 64 64" aria-hidden="true">
                            <circle class="d-track" cx="32" cy="32" r="28" />
                            <circle class="d-arc" cx="32" cy="32" r="28" pathLength="100" style={`--n: ${r.scores[c]}`} />
                          </svg>
                          <b data-score={r.scores[c]}>{r.scores[c]}</b>
                        </span>
                        <span class="d-label">{t.scores[c]}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="s-vitals">
                    <h4>{t.vitals}</h4>
                    <dl>
                      {LAB.map((k) => {
                        const v = byScore(Math.round(r.lab[k].s * 100));
                        return (
                          <div class="vital" data-v={v}>
                            <dt><span class="v-abbr">{t.metrics[k][0]}</span> <span class="v-name">{t.metrics[k][1]}</span></dt>
                            <dd><b>{shown(k, r.lab[k].v)}</b> <span class="v-verdict">{t.verdict[v]}</span></dd>
                          </div>
                        );
                      })}
                    </dl>
                  </div>
                  {r.field && (
                    <div class="s-vitals s-field">
                      <h4>{t.field}</h4>
                      <dl>
                        {(Object.entries(r.field) as [keyof typeof t.metrics, { p75: number; category: string }][]).filter(([, m]) => typeof m === 'object').map(([k, m]) => (
                          <div class="vital" data-v={byCrux(m.category)}>
                            <dt><span class="v-abbr">{t.metrics[k][0]}</span> <span class="v-name">{t.metrics[k][1]}</span></dt>
                            <dd><b>{shown(k, m.p75)}</b> <span class="v-verdict">{t.verdict[byCrux(m.category)]}</span></dd>
                          </div>
                        ))}
                      </dl>
                    </div>
                  )}
                  <p class="s-source">
                    {t.source[r.source]}, {device.toLowerCase()}, {t.measured} {day(r.at)}.
                    <a href={report(run.url, key)} target="_blank" rel="noopener">{t.report}<Fragment set:html={arrow} /></a>
                  </p>
                </div>
              );
            })}
          </section>
        )}

        <div class="p-body" data-in>
          <div class="p-words">
            {p.data.stack.length > 0 && (
              <div class="p-stack">
                <h3>{t.stack}</h3>
                <ul>{p.data.stack.map((x) => <li>{x}</li>)}</ul>
              </div>
            )}
            {Content && (
              <div class="p-story">
                <h3 class="sr-only">{t.story}</h3>
                <div class="prose"><Content /></div>
              </div>
            )}
            {p.data.launching && <p class="p-soon">{t.soon}</p>}
          </div>

          {live ? (
            <figure class="p-browser" data-browser data-src={p.data.live_url} data-name={p.data.title}>
              <figcaption class="b-bar">
                <span class="b-url">{host(p.data.live_url!)}</span>
                {/* without results above, the switch for the site's frame is here */}
                {!run && (
                  <div class="s-switch b-switch" role="group" aria-label={t.viewAs} data-switch>
                    <button type="button" data-mode="phone" aria-pressed="false">{t.phone}</button>
                    <button type="button" data-mode="desktop" aria-pressed="false">{t.desktop}</button>
                  </div>
                )}
                <a class="b-open" href={visit ?? p.data.live_url} target="_blank" rel="noopener">{t.open}<Fragment set:html={arrow} /></a>
              </figcaption>
              <div class="b-view" data-view>
                {p.data.cover && <img class="b-poster" src={p.data.cover} alt={`${p.data.title}: ${t.site}`} width="800" loading="lazy" decoding="async" />}
                <button type="button" class="b-browse" data-preview={p.data.live_url} data-name={p.data.title}
                  data-frame-title={`${p.data.title} ${ui.live.site}`} data-visit={visit ?? p.data.live_url}>
                  <Fragment set:html={expand} />{t.browse}
                </button>
              </div>
            </figure>
          ) : p.data.scope ? (
            <div class="p-spec" style={`--bg: ${bg}; --fg: ${fg}`}>
              {p.data.metric && <p class="spec-metric"><b>{p.data.metric.value}</b> {p.data.metric.label}</p>}
              <ul>{p.data.scope.map((x) => <li>{x}</li>)}</ul>
            </div>
          ) : (
            <!-- not live yet: where it will be -->
            <div class="p-card" style={`--bg: ${bg}; --fg: ${fg}`}>
              {badge && <span>{badge}</span>}
              {p.data.url && <b>{host(p.data.url)}</b>}
            </div>
          )}
        </div>

        <a class="p-next" href={projectHref(following)} data-pick={following.id}>
          {t.next}: {following.data.title}<Fragment set:html={next} />
        </a>
      </article>
    );
  })}

  <LivePreview />
</main>

<script>
  import { projectsHub } from '../scripts/projects';
  const root = document.querySelector<HTMLElement>('[data-hub]');
  if (root) projectsHub(root);
</script>

<style>
  .hub {
    /* PageSpeed's three verdicts, each at ≥4.5:1 on white and on the paper */
    --good: #0a7a3f;
    --average: #a65400;
    --poor: #c42b22;
    padding: calc(var(--topbar-h) + 8px) 0 clamp(96px, 14vh, 168px);
  }

  /* ---- the panel: every project ---- */
  .panel {
    margin-inline: max(20px, env(safe-area-inset-left, 0px));
    padding: clamp(28px, 3.4vw, 52px) 0 clamp(24px, 3vw, 44px);
    border-radius: clamp(20px, 3vw, 36px);
    background: var(--sheet-ink); color: var(--paper);
    --pad: clamp(20px, 3.4vw, 52px);
  }
  .pn-head {
    display: grid; grid-template-columns: auto 1fr auto; align-items: end; gap: 16px clamp(24px, 4vw, 64px);
    padding-inline: var(--pad);
  }
  .pn-head h1 { font-size: clamp(3rem, 9.4vw, 8.75rem); line-height: 0.82; letter-spacing: -0.05em; }
  .pn-lede { margin: 0; max-width: 44ch; font-size: clamp(1.05rem, 1.35vw, 1.25rem); line-height: 1.45; color: color-mix(in srgb, var(--paper) 82%, transparent); }
  .pn-nav { display: flex; gap: 8px; }
  .pn-step {
    display: grid; place-items: center; width: 48px; height: 48px; border: 0; border-radius: 50%;
    background: color-mix(in srgb, var(--paper) 12%, transparent); color: var(--paper); cursor: pointer;
    transition: background-color 0.2s ease, opacity 0.2s ease, scale 0.16s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) { .pn-step:hover { background: color-mix(in srgb, var(--paper) 22%, transparent); } }
  .pn-step:active { scale: 0.94; }
  .pn-step:disabled { opacity: 0.3; cursor: default; }
  :global(html:not(.js)) .pn-nav { display: none; }

  .rail {
    list-style: none; margin: clamp(24px, 3.4vw, 44px) 0 0; padding: 4px var(--pad) 8px;
    display: flex; gap: clamp(12px, 1.4vw, 20px); overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-inline: var(--pad); scrollbar-width: none;
  }
  .rail::-webkit-scrollbar { display: none; }
  .rail li { flex: none; width: clamp(236px, 21vw, 320px); scroll-snap-align: start; }
  .tile { display: grid; gap: 4px; color: inherit; text-decoration: none; border-radius: 14px; outline-offset: 4px; }
  .t-pic {
    position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; margin-bottom: 10px;
    border-radius: 12px; background: var(--bg); color: var(--fg); container-type: size;
    transition: opacity 0.3s ease, scale 0.3s var(--ease-out);
  }
  /* the capture is the whole top of the site: at rest its first screen, under the pointer it runs down the page */
  .t-pic img {
    position: absolute; inset: 0 0 auto; width: 100%; height: auto;
    transition: translate 0.7s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .tile:hover .t-pic img { translate: 0 calc(-100% + 100cqh); transition: translate 7s cubic-bezier(0.45, 0, 0.55, 1); }
  }
  .t-card { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; gap: 2px; padding: 16px; }
  .t-card b { font-size: clamp(2rem, 3vw, 2.8rem); line-height: 0.9; letter-spacing: -0.05em; }
  .t-card .t-word { text-transform: uppercase; font-size: clamp(1.6rem, 2.4vw, 2.2rem); }
  .t-card span { font-size: 0.875rem; font-weight: 500; }
  .t-name { font-size: 1.1875rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; }
  .t-kind { font-size: 0.9375rem; color: color-mix(in srgb, var(--paper) 66%, transparent); }
  /* the one picked: the rest step back */
  :global(html.js) .rail:has([aria-current]) .tile:not([aria-current]) .t-pic { opacity: 0.5; }
  .tile[aria-current] .t-name::before {
    content: ''; display: inline-block; width: 0.5em; height: 0.5em; margin-right: 0.4em; border-radius: 50%;
    background: var(--accent); vertical-align: 0.08em;
  }
  @media (hover: hover) and (pointer: fine) {
    :global(html.js) .rail .tile:hover .t-pic { opacity: 1; }
  }
  .tile:active .t-pic { scale: 0.98; }

  /* ---- the project ---- */
  .proj { padding-top: clamp(64px, 10vh, 120px); }
  .p-head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; row-gap: clamp(20px, 3vh, 32px); align-items: end; }
  .p-title { grid-column: 1 / -1; font-size: clamp(3rem, 10vw, 9.5rem); line-height: 0.84; letter-spacing: -0.055em; }
  .p-summary { grid-column: 1 / 8; margin: 0; max-width: 40ch; font-size: clamp(1.2rem, 1.9vw, 1.65rem); line-height: 1.35; letter-spacing: -0.01em; }
  .p-meta { grid-column: 8 / -1; justify-self: end; display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 10px 16px; }
  .p-kind { font-size: 1rem; font-weight: 500; color: var(--accent-ink); }
  .p-badge { padding: 6px 12px; border-radius: 100px; background: color-mix(in srgb, var(--fg) 8%, transparent); font-size: 0.875rem; font-weight: 500; }
  .p-visit, .b-browse {
    display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 22px; border-radius: 100px;
    background: var(--fg); color: var(--paper); font-weight: 700; font-size: 1rem; text-decoration: none;
    transition: background-color 0.2s ease, scale 0.16s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) { .p-visit:hover { background: var(--cobalt); } }
  .p-visit:active, .b-browse:active { scale: 0.97; }

  /* PageSpeed: four scores and the vitals, as a phone or a desktop gets them */
  .p-speed { margin-top: clamp(48px, 7vh, 88px); padding: clamp(22px, 2.6vw, 40px); border-radius: clamp(18px, 2vw, 28px); background: var(--surface); }
  .s-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .s-head h3 { font-size: clamp(1.6rem, 2.6vw, 2.4rem); }
  .s-switch { display: inline-flex; padding: 4px; border-radius: 100px; background: color-mix(in srgb, var(--fg) 7%, transparent); }
  .s-switch button {
    min-height: 40px; padding: 0 18px; border: 0; border-radius: 100px; background: none; cursor: pointer;
    font-size: 0.9375rem; font-weight: 600; transition: background-color 0.2s ease, color 0.2s ease;
  }
  .s-switch button[aria-pressed='true'] { background: var(--fg); color: var(--paper); }
  :global(html:not(.js)) .s-switch { display: none; }
  .s-device { margin: 28px 0 0; font-size: 1.125rem; }
  :global(html.js) .s-device { display: none; }
  /* with script one run shows: the device the switch names, at first the reader's own */
  :global(html.js) .hub[data-mode='phone'] .s-run[data-run='desktop'],
  :global(html.js) .hub[data-mode='desktop'] .s-run[data-run='mobile'] { display: none; }
  @media (min-width: 821px) { :global(html.js) .hub:not([data-mode]) .s-run[data-run='mobile'] { display: none; } }
  @media (max-width: 820px) { :global(html.js) .hub:not([data-mode]) .s-run[data-run='desktop'] { display: none; } }

  .s-run { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; row-gap: 28px; margin-top: clamp(24px, 3vh, 36px); }
  .s-scores { grid-column: 1 / 6; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 16px; align-content: start; }
  .dial { display: grid; justify-items: center; gap: 10px; text-align: center; }
  .d-ring { position: relative; display: grid; place-items: center; width: min(100%, 128px); aspect-ratio: 1; }
  .d-ring svg { position: absolute; inset: 0; width: 100%; height: 100%; rotate: -90deg; }
  .d-track { fill: none; stroke: color-mix(in srgb, var(--fg) 8%, transparent); stroke-width: 6; }
  .d-arc {
    fill: none; stroke: currentColor; stroke-width: 6; stroke-linecap: round;
    stroke-dasharray: 100; stroke-dashoffset: calc(100 - var(--n));
    transition: stroke-dashoffset 1.1s var(--ease-out);
  }
  /* waiting to be drawn (the script adds .drawn as the scores come into view) */
  :global(html.js) .s-run:not(.drawn) .d-arc { stroke-dashoffset: 100; transition: none; }
  .d-ring b { position: relative; font-size: clamp(1.75rem, 2.6vw, 2.5rem); letter-spacing: -0.04em; font-variant-numeric: tabular-nums; color: var(--fg); }
  .d-label { font-size: 1rem; font-weight: 500; line-height: 1.2; }
  .dial[data-v='good'], .vital[data-v='good'] { color: var(--good); }
  .dial[data-v='average'], .vital[data-v='average'] { color: var(--average); }
  .dial[data-v='poor'], .vital[data-v='poor'] { color: var(--poor); }
  .d-label { color: var(--fg); }

  .s-vitals { grid-column: 7 / -1; }
  .s-field { grid-column: 1 / -1; }
  .s-vitals h4 { margin: 0 0 14px; font-size: 1.0625rem; letter-spacing: -0.01em; }
  .s-vitals dl { margin: 0; display: grid; gap: 8px; }
  /* a row each: the metric, its value, PageSpeed's verdict */
  .vital {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 4px 20px;
    padding: 14px 18px; border-radius: 14px; background: color-mix(in srgb, var(--fg) 4%, transparent);
  }
  .vital dt { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; color: var(--fg); }
  .v-abbr { font-size: 1.0625rem; font-weight: 700; }
  .v-name { font-size: 0.875rem; color: var(--muted); line-height: 1.25; }
