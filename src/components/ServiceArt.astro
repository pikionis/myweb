---
// One drawing per /services card, by service: line art in the card's ink with one accent (--art-ac) on the
// card's ground (--art-bg). Each is drawn as it ends, which is how it rests on the closed card and with reduced
// motion; src/scripts/serviceart.ts plays it from nothing when the card opens. The parts it moves are named
// by data-p; strokes draw on as in the stories (lineart.ts). The words are in src/data/serviceart.ts.
import { r1, C, R, P, D, cls } from './lineart';
import { serviceArt as A } from '../data/serviceart';
import type { CardKey } from '../data/site';

interface Props { name: CardKey }
const { name } = Astro.props;

type N = number;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
/** a part the script moves */
const G = (p: string, inner: string, attrs = '') => `<g data-p="${p}"${attrs ? ` ${attrs}` : ''}>${inner}</g>`;
/** a filled shape (it does not draw on) */
const F = (d: string, extra: string, attrs = '') => `<path class="${extra}" d="${d}"${attrs ? ` ${attrs}` : ''}/>`;
/** a line of words */
const X = (x: N, y: N, text: string, size: N, extra = '', attrs = '') =>
  `<text class="${cls('t', extra)}" x="${x}" y="${y}" font-size="${size}"${attrs ? ` ${attrs}` : ''}>${esc(text)}</text>`;
/** how wide a line of words comes out (Space Grotesk, medium, near enough) */
const width = (text: string, size: N) => Math.round(text.length * size * 0.56);
/** a five-pointed star */
const star = (cx: N, cy: N, r: N) => 'M' + Array.from({ length: 10 }, (_, i) => {
  const a = -Math.PI / 2 + (i * Math.PI) / 5, d = i % 2 ? r * 0.45 : r;
  return `${r1(cx + d * Math.cos(a))} ${r1(cy + d * Math.sin(a))}`;
}).join('L') + 'Z';
/** a four-pointed sparkle: the drawings' sign for AI at work */
const spark = (cx: N, cy: N, r: N) => `M${cx} ${cy - r}Q${cx} ${cy} ${cx + r} ${cy}Q${cx} ${cy} ${cx} ${cy + r}Q${cx} ${cy} ${cx - r} ${cy}Q${cx} ${cy} ${cx} ${cy - r}Z`;
/** three dots: someone is typing */
const dots = (x: N, y: N, inv = false) => [0, 1, 2].map((i) => `<circle class="${inv ? 'dot inv-fill' : 'dot'}" cx="${x + i * 10}" cy="${y}" r="3"/>`).join('');

const ART: Record<CardKey, () => string> = {
  // ---- Custom web & design: a site builds itself, ready for AI, in three languages, with a chat on the side ----
  web: () => {
    const w = A.web;
    const hello = width(w.greet, 12) + 28;
    return [
      G('w-llms', P('M392 116H454L472 134V238H392Z', 'solid') + P('M454 116V134H472') + P('M426 150H460') + P('M426 164H452') + P('M426 178H460') + X(422, 222, w.llms, 10.5)),
      G('w-frame', P(R(64, 56, 352, 236, 14), 'solid') + P('M64 86H416') + D(84, 71, 3.2) + D(96, 71, 3.2) + D(108, 71, 3.2)),
      G('w-nav', P(R(84, 100, 30, 10, 3)) + P('M232 105H254') + P('M266 105H288')),
      G('w-lang', P(R(320, 94, 44, 22, 11)) + w.langs.map((l, i) => X(342, 109, l, 11, '', `text-anchor="middle" data-l="${i}"${i ? ' opacity="0"' : ''}`)).join('')),
      G('w-hero', P(R(84, 124, 312, 70, 10))),
      G('w-copy', P('M102 146H250', 'thick') + P('M102 162H206')),
      G('w-btn', F(R(102, 172, 62, 14, 7), 'ac-fill')),
      G('w-ring', F(R(96, 166, 74, 26, 13), 'ac ring')),
      G('w-cards', [84, 192, 300].map((x) => P(R(x, 208, 96, 64, 8)) + P(`M${x + 12} 248H${x + 64}`) + P(`M${x + 12} 260H${x + 44}`)).join('')),
      G('w-data', P(R(22, 36, 66, 34, 17), 'solid ac') + X(55, 58, w.data, 14, 't-ac', 'text-anchor="middle"')),
      G('w-hello', P(R(398 - hello, 218, hello, 30, 15), 'solid') + G('w-typing', dots(398 - hello + 16, 233), 'opacity="0"') + G('w-greet', X(398 - hello + 14, 237, w.greet, 12))),
      G('w-chat', `<circle class="ac-fill" cx="404" cy="276" r="17"/>` + F('M396 270h16v10h-9l-5 4v-4h-2z', 'inv')),
    ].join('');
  },

  // ---- AI services & bots: a guest asks, the bot answers and books, the guest is delighted ----
  bots: () => {
    const h = 32, gap = 12, y0 = 28;
    const chat = A.bots.map((m, i) => {
      const y = y0 + i * (h + gap);
      const bot = m.from === 'bot';
      const done = bot && i === A.bots.length - 1;
      const w = width(m.text, 13) + 28 + (done ? 18 : 0);
      const x = bot ? 340 - w : 140;
      const shape = bot ? F(R(x, y, w, h, 16), 'fill') : P(R(x, y, w, h, 16), 'solid');
      const check = done ? F(`M${x + 13} ${y + 16}l4 4 8-9`, 'inv') : '';
      const typing = bot ? G(`typing-${i}`, F(R(340 - 54, y, 54, h, 16), 'fill') + dots(340 - 54 + 17, y + 16, true), 'opacity="0"') : '';
      return typing + G(`msg-${i}`, shape + check + X(x + 14 + (done ? 18 : 0), y + 21, m.text, 13, bot ? 't-inv' : ''), `data-from="${m.from}"`);
    }).join('');
    const guest = G('guest', [
      G('g-burst', P('M56 166L46 156', 'ac') + P('M88 158V144', 'ac') + P('M120 166L130 156', 'ac')),
      G('g-arms', P('M62 258L40 218') + P('M114 258L136 218')),
      G('g-head', P(C(88, 196, 20)) + D(81, 193, 2.4) + D(95, 193, 2.4)
        + G('g-flat', P('M82 205H94'), 'opacity="0"') + G('g-smile', P('M79 202Q88 213 97 202'))),
      P('M50 300C50 254 68 234 88 234C108 234 126 254 126 300'),
    ].join(''));
    const robot = G('robot', [
      P('M392 150V139'),
      `<circle data-p="r-light" class="ac-fill sa-f" cx="392" cy="133" r="5"/>`,
      P(R(358, 150, 68, 50, 12)),
      P('M358 166H352V184H358') + P('M426 166H432V184H426'),
      G('r-eyes', P(R(374, 166, 10, 12, 4)) + P(R(400, 166, 10, 12, 4))),
      P('M382 188H402'),
      P('M392 200V224'),
      P('M352 300V242Q352 224 370 224H414Q432 224 432 242V300'),
    ].join(''));
    return guest + robot + chat;
  },

  // ---- AI SaaS & web applications: five tools become one system, and the data answers in plain words ----
  apps: () => {
    const a = A.apps;
    const ys = [96, 138, 180, 222, 264];
    // where each tool floats before it joins the system
    const from = [[62, 40], [430, 34], [30, 196], [456, 200], [252, 336]];
    const icon = [
      (x: N, y: N) => P(R(x - 8, y - 7, 16, 11, 3)) + P(`M${x - 4} ${y + 4}l-2 4 5-4`),
      (x: N, y: N) => P(R(x - 8, y - 6, 16, 14, 3)) + P(`M${x - 8} ${y - 1}H${x + 8}`) + P(`M${x - 4} ${y - 9}v4M${x + 4} ${y - 9}v4`),
      (x: N, y: N) => P(C(x - 2, y - 3, 3.5)) + P(`M${x - 8} ${y + 8}c0-5 2.5-7 6-7s6 2 6 7`) + P(C(x + 6, y - 4, 2.5)),
      (x: N, y: N) => P(`M${x - 6} ${y - 8}h12v16l-3-2-3 2-3-2-3 2z`) + P(`M${x - 3} ${y - 3}h6M${x - 3} ${y + 1}h6`),
      (x: N, y: N) => P(`M${x - 8} ${y - 3}v6h3l8 5v-16l-8 5z`) + P(`M${x + 6} ${y - 4}q3 4 0 8`),
    ];
    const tools = ys.map((y, i) => G(`tool-${i}`, P(R(108, y - 15, 30, 30, 8), 'solid') + icon[i](123, y),
      `data-dx="${from[i][0] - 123}" data-dy="${from[i][1] - y}"`)).join('');
    const ly = [62, 84, 96, 74], ty = [80, 104, 132, 92];
    const bars = a.months.map((m, i) => {
      const x = 184 + i * 56;
      return `<rect class="ly" data-p="bar" x="${x}" y="${276 - ly[i]}" width="16" height="${ly[i]}" rx="2"/>`
        + `<rect class="ac-fill" data-p="bar" x="${x + 20}" y="${276 - ty[i]}" width="16" height="${ty[i]}" rx="2"/>`
        + X(x + 18, 293, m, 10, i === 2 ? 't-strong' : '', 'text-anchor="middle"');
    }).join('');
    return [
      G('a-frame', P(R(96, 60, 332, 244, 14), 'solid') + P('M152 60V304')),
      G('a-ask', P(R(166, 76, 248, 28, 14)) + F(spark(181, 90, 6), 'ac-fill') + X(193, 94, a.ask, 10.5, '', 'data-type')),
      G('a-chart', P('M170 276H414') + bars),
      G('a-fore', F('M388 184L414 150', 'ac dash') + F('M404 150H414V160', 'ac')),
      tools,
    ].join('');
  },

  // ---- E-commerce & marketplaces: AI writes the product, twenty languages, in sync with the marketplaces ----
  commerce: () => {
    const c = A.commerce;
    const shops = [110, 190, 270];
    const curve = (y: N) => `M204 190C262 190 300 ${y} 376 ${y}`;
    const pills = [...c.langs, c.more].map((l, i) => {
      const x = 48 + i * 42, more = i === c.langs.length;
      return G(`lang-${i}`, P(R(x, 36, 36, 24, 12), more ? 'solid ac' : 'solid') + X(x + 18, 52, l, 11, more ? 't-ac' : '', 'text-anchor="middle"'));
    }).join('');
    return [
      G('c-card', P(R(48, 88, 156, 200, 14), 'solid') + P(R(62, 102, 128, 86, 8)) + P('M104 132H148L152 174H100Z') + P('M114 132V126a12 12 0 0 1 24 0V132') + P(R(62, 252, 54, 22, 11))),
      G('c-desc', P('M62 206H190') + P('M62 220H172') + P('M62 234H182')),
      G('c-spark', F(spark(196, 198, 9), 'ac-fill')),
      pills,
      shops.map((y, i) => G(`c-line-${i}`, P(curve(y), '', `data-path="${i}"`))).join(''),
      shops.map((y, i) => G(`shop-${i}`, P(R(376, y - 20, 72, 42, 8), 'solid') + P(`M376 ${y - 8}H448`) + P(`M406 ${y + 22}V${y + 6}H418V${y + 22}`))).join(''),
      // the packets in flight between the shop and the marketplaces (they rest halfway)
      shops.map((y, i) => `<circle class="ac-fill" data-p="packet-${i}" cx="${r1(0.125 * 204 + 0.375 * 262 + 0.375 * 300 + 0.125 * 376)}" cy="${r1(0.5 * 190 + 0.5 * y)}" r="4.5"/>`).join(''),
      G('c-mail', P(R(80, 308, 52, 36, 6), 'solid') + P('M80 312L106 330L132 312') + F('M146 302c-3-4-9-2-8 3 1 4 8 8 8 8s7-4 8-8c1-5-5-7-8-3z', 'ac-fill')),
    ].join('');
  },

  // ---- AI search, marketing & ads: an AI answers with your business first; reviews answered; ads that grow ----
  search: () => {
    const s = A.search;
    const qw = width(s.ask, 12) + 28;
    const rows = [130, 178, 226].map((y, i) => G(`row-${i}`,
      P(R(56, y, 280, 40, 10), i ? 'solid' : 'solid ac') + P(R(64, y + 8, 24, 24, 6), i ? '' : 'ac')
      + (i ? P(`M98 ${y + 15}H190`) : X(98, y + 19, s.you, 12, 't-ac t-strong'))
      + P(`M98 ${y + 28}H${i ? 160 : 210}`)
      + (i ? '' : G('s-star', F(star(316, y + 20, 9), 'ac-fill'))))).join('');
    const stars = [0, 1, 2, 3, 4].map((i) => F(star(382 + i * 17, 112, 6.5), 'ac-fill', `data-p="rstar"`)).join('');
    return [
      G('s-frame', P(R(40, 40, 312, 268, 16), 'solid') + P('M40 74H352') + F(spark(62, 57, 7), 'ac-fill') + P('M80 57H128')),
      G('s-q', F(R(336 - qw, 86, qw, 30, 15), 'fill') + X(336 - qw + 14, 106, s.ask, 12, 't-inv', 'data-type')),
      G('s-typing', P(R(56, 130, 56, 30, 15), 'solid') + dots(73, 145), 'opacity="0"'),
      rows,
      G('s-review', P(R(364, 92, 104, 70, 10), 'solid') + stars + P('M376 134H454') + P('M376 146H430')),
      G('s-reply', F(R(364, 172, 104, 40, 12), 'fill') + F('M376 186H448M376 198H422', 'inv') + F(spark(466, 170, 7), 'ac-fill')),
      G('s-ads', P('M364 304H470') + P('M368 298L392 282L414 288L440 260L464 242', 'ac') + P('M455 241L464 242L462 251', 'ac')),
    ].join('');
  },
};
---
<svg class="sv" data-art={name} viewBox="0 0 480 360" aria-hidden="true" focusable="false" set:html={ART[name]()} />

<style>
  .sv { display: block; width: 100%; height: auto; overflow: visible; }
  .sv :global(path), .sv :global(rect) { fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .sv :global(.sa-d) { stroke-dasharray: 1 2; }
  .sv :global(.thick) { stroke-width: 7; }
  .sv :global(.ac) { stroke: var(--art-ac); }
  .sv :global(.solid) { fill: var(--art-bg); }
  .sv :global(.fill) { fill: currentColor; stroke: none; }
  .sv :global(.ac-fill) { fill: var(--art-ac); stroke: none; }
  .sv :global(.inv) { stroke: var(--art-bg); }
  .sv :global(.ring), .sv :global(.dash) { stroke-dasharray: 5 6; }
  .sv :global(.ly) { stroke-width: 2; }
  .sv :global(circle) { fill: currentColor; }
  .sv :global(circle.inv-fill) { fill: var(--art-bg); }
  .sv :global(.t) { fill: currentColor; stroke: none; font-weight: 500; }
  .sv :global(.t-inv) { fill: var(--art-bg); }
  .sv :global(.t-ac) { fill: var(--art-ac); }
  .sv :global(.t-strong) { font-weight: 700; }
</style>
