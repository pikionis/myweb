---
import type { ServiceCard } from '../data/projects';
import { serviceColors, artAccent, ui } from '../data/site';
import ServiceArt from './ServiceArt.astro';

interface Props { cards: ServiceCard[] }
const { cards } = Astro.props;
const t = ui.servicesPage;
const pad = (n: number) => String(n).padStart(2, '0');
const icon = (d: string, size = 18) =>
  `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;
---
<!-- Each /services card, opened (src/scripts/servicesheets.ts): the card grows out of its place over the page,
     its drawing plays as a short story, and everything the service includes is there to read. One at a time;
     Close, Esc or a click beside it folds it back into its card. Each has an address (#service-bots …). The
     sheets are in the page from the start: without script they follow the cards as plain sections. -->
<div class="sheets" data-sheets>
  <div class="sheets-backdrop" data-sheets-backdrop></div>
  {cards.map((s, i) => {
    const [bg, fg] = serviceColors[s.key];
    return (
      <article class="svc-sheet" id={`service-${s.key}`} data-sheet={s.key} role="dialog" aria-modal="true"
        aria-labelledby={`service-${s.key}-title`} tabindex="-1"
        style={`--bg: ${bg}; --fg: ${fg}; --art-bg: ${bg}; --art-ac: ${artAccent[s.key]}`}>
        <header class="sheet-top">
          <p class="sheet-num" aria-hidden="true">{pad(i + 1)}</p>
          <h2 id={`service-${s.key}-title`}>{s.title}</h2>
          <button type="button" class="sheet-close" data-sheet-close aria-label={t.close}>
            <Fragment set:html={icon('M6 6l12 12M18 6L6 18')} />
          </button>
        </header>
        <div class="sheet-body" data-sheet-body tabindex="-1">
          <div class="sheet-art">
            <ServiceArt name={s.key} />
            <button type="button" class="replay" data-replay>
              <Fragment set:html={icon('M4 12a8 8 0 1 0 2.4-5.7M4 4v4.5h4.5', 16)} />{t.replay}
            </button>
          </div>
          <div class="sheet-text">
            <p class="sheet-claim">{s.claim ?? s.lead}</p>
            <h3 class="sheet-label">{t.included}</h3>
            <ul class="sheet-list">
              {s.includes.map((x) => (
                <li><Fragment set:html={icon('M5 12.5l4.5 4.5L19 7.5', 20)} /><span>{x}</span></li>
              ))}
            </ul>
            {(s.projects.length > 0 || s.proof) && (
              <div class="sheet-links">
                <h3 class="sheet-label">{s.projects.length ? t.projects : s.proof!.label}</h3>
                <ul>
                  {s.projects.map((p) => <li><a href={`/projects/${p.id}`}>{p.data.title}</a></li>)}
                  {!s.projects.length && s.proof && <li><a href={s.proof.link.href}>{s.proof.name}</a></li>}
                </ul>
              </div>
            )}
            <a class="sheet-cta" href={`/contact?type=project&service=${s.key}`}>{t.start}</a>
          </div>
        </div>
      </article>
    );
  })}
</div>

<style>
  /* ---- with script: one card open at a time, over the page ---- */
  :global(html.js) .sheets { display: none; }
  :global(html.js) .sheets.open {
    position: fixed; inset: 0; z-index: 90; display: flex; align-items: center; justify-content: center;
    padding: clamp(10px, 3vw, 40px);
  }
  :global(html.js) .svc-sheet:not(.open) { display: none; }
  .sheets-backdrop { position: absolute; inset: 0; background: rgb(20 20 20 / 0.5); }

  .svc-sheet {
    --r: clamp(18px, 2vw, 30px); --pad: clamp(20px, 3vw, 44px);
    position: relative; display: flex; flex-direction: column; width: min(1180px, 100%); height: 100%; overflow: hidden;
    border-radius: var(--r); background: var(--bg); color: var(--fg); outline: none;
    box-shadow: 0 40px 90px -30px rgb(0 0 0 / 0.55);
  }
  .sheet-top {
    flex: none; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0 clamp(14px, 2vw, 28px);
    padding: clamp(18px, 2.6vw, 32px) var(--pad);
    border-bottom: 1px solid color-mix(in srgb, var(--fg) 14%, transparent);
  }
  .sheet-num { margin: 0; font-size: clamp(1.5rem, 2.5vw, 2.25rem); font-weight: 500; line-height: 1; letter-spacing: -0.06em; }
  .sheet-top h2 { font-size: clamp(1.4rem, 3vw, 2.6rem); line-height: 1; letter-spacing: -0.04em; text-wrap: balance; }
  .sheet-close {
    display: grid; place-items: center; width: 48px; height: 48px; border: 0; border-radius: 50%; cursor: pointer;
    background: var(--fg); color: var(--bg); transition: scale 0.16s var(--ease-out), opacity 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) { .sheet-close:hover { opacity: 0.85; } }
  .sheet-close:active { scale: 0.94; }

  .sheet-body {
    flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; outline: none;
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px);
    padding: clamp(20px, 3vw, 40px) var(--pad) clamp(28px, 4vw, 48px);
  }
  /* the drawing stays in sight while the list scrolls past it */
  .sheet-art { position: sticky; top: 0; align-self: start; display: grid; justify-items: center; gap: 8px; }
  .sheet-art :global(.sv) { max-height: calc(100svh - 300px); }
  .replay {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px; border: 0; border-radius: 100px;
    background: transparent; color: inherit; font: inherit; font-size: 0.9375rem; font-weight: 500; cursor: pointer;
    text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); text-underline-offset: 0.25em;
  }
  @media (hover: hover) and (pointer: fine) { .replay:hover { text-decoration-color: currentColor; } }

  .sheet-claim { margin: 0; max-width: 18ch; font-size: clamp(1.6rem, 2.8vw, 2.6rem); font-weight: 700; line-height: 0.98; letter-spacing: -0.04em; text-transform: uppercase; text-wrap: balance; }
  .sheet-label { margin: clamp(24px, 3vw, 36px) 0 14px; font-size: 0.9375rem; font-weight: 500; opacity: 0.75; letter-spacing: 0; text-transform: none; }
  .sheet-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .sheet-list li { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 12px; align-items: start; max-width: 52ch; font-size: clamp(1rem, 1.15vw, 1.0625rem); line-height: 1.45; }
  .sheet-list :global(svg) { margin-top: 1px; color: var(--art-ac); }
  .sheet-links ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .sheet-links a {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem); font-weight: 700; text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); text-underline-offset: 0.2em; transition: text-decoration-color 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) { .sheet-links a:hover { text-decoration-color: currentColor; } }
  .sheet-cta {
    display: inline-flex; align-items: center; min-height: 56px; margin-top: clamp(28px, 3.4vw, 40px); padding: 0 32px; border-radius: 100px;
    background: var(--fg); color: var(--bg); font-weight: 700; font-size: 1.0625rem; text-decoration: none;
    transition: opacity 0.2s ease, scale 0.16s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) { .sheet-cta:hover { opacity: 0.88; } }
  .sheet-cta:active { scale: 0.97; }
  .sheet-close:focus-visible, .replay:focus-visible, .sheet-cta:focus-visible, .sheet-links a:focus-visible {
    outline: 2px solid currentColor; outline-offset: 3px;
  }

  /* a phone: the drawing above, then the list; the whole sheet scrolls */
  @media (max-width: 860px) {
    :global(html.js) .sheets.open { padding: 10px; }
    .sheet-top { grid-template-columns: minmax(0, 1fr) auto; }
    .sheet-num { display: none; }
    .sheet-close { width: 44px; height: 44px; }
    .sheet-body { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .sheet-art { position: static; }
    .sheet-art :global(.sv) { max-height: 34svh; }
  }

  /* ---- no script: each one a section after the cards ---- */
  :global(html:not(.js)) .sheets-backdrop, :global(html:not(.js)) .sheet-close, :global(html:not(.js)) .replay { display: none; }
  :global(html:not(.js)) .svc-sheet { width: min(1120px, calc(100% - 40px)); height: auto; margin: 0 auto 24px; box-shadow: none; }
  :global(html:not(.js)) .sheet-body { overflow: visible; }
</style>
