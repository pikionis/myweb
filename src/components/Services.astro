---
import { servicesWithProjects, hasStory, projectHref, visitUrl, badgeOf } from '../data/projects';
import { serviceColors, ui } from '../data/site';
import { stories } from '../data/stories';
import LivePreview from './LivePreview.astro';

const services = await servicesWithProjects();
// a service's cards: its projects, then (AI search) the card about this very site
const cardCount = (s: (typeof services)[number]) => s.projects.length + (s.proof ? 1 : 0);
// scroll steps: each service after the first slides in, and so does each card after a service's first
const steps = (services.length - 1) + services.reduce((n, s) => n + Math.max(cardCount(s) - 1, 0), 0);
const arrow = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>';
const down = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>';
const storyOf = (key: string) => stories.find((st) => st.service === key);
const expand = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7" /></svg>';
const up = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg>';
// a project's own text, unless it is still to be written; then its one-line summary
const ownText = (p: (typeof services)[number]['projects'][number]) =>
  p.data.blurb && !/^\s*\[TODO/.test(p.data.blurb) ? p.data.blurb : p.data.summary;
const next = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';
const check = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>';
---
<section id="services" class="work">
  <header class="wrap sec-head">
    <h2>{ui.work.title}</h2>
    <p>{ui.work.intro} <a href="/services">{ui.work.allServices}</a> · <a href="/projects">{ui.work.allProjects}</a></p>
  </header>

  <!-- Services stack as sheets; inside each sheet its projects stack the same way (src/scripts/workstack.ts) -->
  <div class="stack" data-stack style={`--steps: ${steps}`}>
    <div class="pin">
      {services.map((s, i) => {
        // each project's own text sits beside the projects, following the card on top (or under the pointer)
        const beside = s.projects.some((p) => p.data.blurb);
        return (
          <article class:list={['svc', s.background.tone]} data-sheet data-image={s.background.image ? '' : undefined}
            style={`--i: ${i}; --ground: var(--sheet-${s.background.fill})${s.background.image ? `; --image: url(${s.background.image})` : ''}`}>
            <!-- on a phone, once the next sheet covers this one, its band offers a way back to it -->
            <button type="button" class="again-tab" data-again aria-label={`${ui.work.again}: ${s.title}`}>{ui.work.again}<Fragment set:html={up} /></button>
            <div class="wrap svc-in">
              <h3 data-cascade>{s.title}</h3>
              <div class="copy">
                <p class="lead">{s.lead}</p>
                {s.body.map((t) => <p class="body">{t}</p>)}
                {s.chips.length > 0 && <ul class="chips">{s.chips.map((c) => <li>{c}</li>)}</ul>}
                {beside && (
                  <div class="blurbs" data-blurbs>
                    {s.projects.map((p, j) => (
                      <p class:list={['blurb', { on: j === 0 }]} data-blurb>
                        <span class="bname">{p.data.title}</span> {p.data.blurb ?? p.data.summary}
                        {hasStory(p) && <a class="bstory" href={projectHref(p)}>{ui.readStory}<Fragment set:html={next} /></a>}
                      </p>
                    ))}
                  </div>
                )}
              </div>
              {storyOf(s.key) && (
                <button type="button" class="read-more" data-read-more={s.key} aria-controls={storyOf(s.key)!.id} aria-expanded="false"
                  aria-label={`${ui.stories.readMore}${ui.stories.readMoreRest}: ${s.title}`}>
                  <span>{ui.stories.readMore}<span class="rm-rest">{ui.stories.readMoreRest}</span></span>
                  <Fragment set:html={down} />
                </button>
              )}
              <div class="pstack">
                {s.projects.map((p, j) => {
                  const [bg, fg] = serviceColors[p.data.services[0] ?? 'none'];
                  const { metric, scope, live_url: live } = p.data;
                  return (
                    <article class="pcard" data-pcard style={`--j: ${j}`}>
                      <div class="pband">
                        <a class="pname" href={projectHref(p)} data-cascade>{p.data.title}</a>
                        {badgeOf(p) && <span class="badge">{badgeOf(p)}</span>}
                        {visitUrl(p) && (
                          <a class="visit" href={visitUrl(p)} target="_blank" rel="noopener" aria-label={`${ui.visitSite}: ${p.data.title}`}>
                            {ui.visitSite}<Fragment set:html={arrow} />
                          </a>
                        )}
                      </div>
                      <div class:list={['pmedia', { spec: scope && !live }]} style={`--mbg: ${bg}; --mfg: ${fg}`}>
                        {live ? (
                          <!-- the live site (src/scripts/livesites.ts): its frame is made as its card comes near (on a
                               slow connection the browser's own lazy loading fetched every site with the page, and an
                               empty frame in the page made it lay the page out while still reading it); its title card
                               shows until the site paints over it. Without script, the frame is the <noscript> one -->
                          <div class="site-live" data-live data-src={live} data-title={`${p.data.title} ${ui.live.site}`}>
                            <span class="pfallback" aria-hidden="true" data-t={p.data.title}></span>
                            <noscript><iframe src={live} title={`${p.data.title} ${ui.live.site}`} loading="lazy" tabindex="-1" credentialless
                              sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox"></iframe></noscript>
                            <!-- a phone: the finger scrolls the page; this opens the site full screen to scroll through it -->
                            <button type="button" class="live-preview" data-preview={live} data-name={p.data.title}
                              data-frame-title={`${p.data.title} ${ui.live.site}`} data-visit={visitUrl(p) ?? live}
                              aria-label={`${ui.live.preview}: ${p.data.title}`}>
                              <Fragment set:html={expand} />{ui.live.preview}
                            </button>
                          </div>
                        ) : scope ? (
                          <>
                            {metric && <p class="metric"><b>{metric.value}</b> {metric.label}</p>}
                            <ul class="scope">{scope.map((x) => <li>{x}</li>)}</ul>
                          </>
                        ) : p.data.video ? (
                          <video data-src={p.data.video} poster={p.data.cover} muted loop playsinline preload="none" aria-label={`Design video of ${p.data.title}`}></video>
                        ) : p.data.cover ? (
                          <img src={p.data.cover} alt="" loading="lazy" />
                        ) : (
                          <span class="pfallback" aria-hidden="true" data-t={p.data.title}></span>
                        )}
                      </div>
                      <p class="pline">{beside ? p.data.summary : (p.data.blurb ?? p.data.summary)}</p>
                      <!-- on a phone the project's own text comes under its picture, not before the cards -->
                      <div class="ptext">
                        <p>{ownText(p)}</p>
                        {hasStory(p) && <a class="bstory" href={projectHref(p)}>{ui.readStory}<Fragment set:html={next} /></a>}
                      </div>
                    </article>
                  );
                })}
                {s.proof && (
                  <article class="pcard proof" data-pcard style={`--j: ${s.projects.length}`}>
                    <div class="pband">
                      <span class="pname">{s.proof.name}</span>
                      <span class="badge">{s.proof.label}</span>
                    </div>
                    <div class="pmedia spec" style={`--mbg: ${serviceColors[s.key][0]}; --mfg: ${serviceColors[s.key][1]}`}>
                      <ul class="checks">{s.proof.items.map((x) => <li><Fragment set:html={check} />{x}</li>)}</ul>
                    </div>
                    <p class="pline"><a href={s.proof.link.href}>{s.proof.link.text}</a></p>
                  </article>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <LivePreview />
</section>

<style>
  /* the light page shows between the last sheet and the dark footer, so the two never run together */
  .work { padding-bottom: clamp(64px, 10vh, 120px); }
  .sec-head { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 48px; align-items: end; margin-bottom: clamp(24px, 4vh, 48px); }
  .sec-head h2 { font-size: clamp(2.4rem, 8vw, 6rem); }
  .sec-head p { margin: 0; max-width: 44ch; font-size: clamp(1.15rem, 1.6vw, 1.4rem); line-height: 1.45; justify-self: end; }
  .sec-head a { text-decoration-color: var(--accent); text-underline-offset: 0.25em; white-space: nowrap; }

  /* ---- flow: no script, reduced motion or a small screen — the sheets and their projects follow one another ---- */
  .stack { --top: 84px; --band: 72px; --pband: 64px; margin-top: clamp(40px, 6vh, 80px); }
  /* each sheet and each card is its own layer, so a card's link (raised inside it) never reaches over a later one */
  .svc {
    position: relative; isolation: isolate; border-radius: clamp(20px, 3vw, 36px) clamp(20px, 3vw, 36px) 0 0;
    background: var(--ground);
  }
  /* the words' colours follow the sheet's tone (background.tone in site.ts) */
  .svc.light { color: #141414; --card: #ffffff; --meta: #3f3f3b; --tag: #2a55d9; --scrim: rgb(232 230 223 / 0.86); }
  .svc.dark { color: #f4f3ef; --card: #1f201d; --meta: #b9b8b0; --tag: #7a9bff; --scrim: rgb(20 20 20 / 0.86); }
  /* a picture behind a sheet sits under a scrim of the sheet's own ground, which keeps every word at 4.5:1
     or better whatever the picture */
  .svc[data-image] { background: var(--image) center / cover no-repeat; }
  /* depth: as sheets stack, the ones further back sit a little smaller and darker, like folders inside a folder
     (--shade and the scale are set by workstack.ts; in the flow both stay at rest) */
  .svc::after { content: ''; position: absolute; inset: 0; z-index: 6; border-radius: inherit; pointer-events: none; background: rgb(10 11 10 / var(--shade, 0)); }
  .svc[data-image]::before { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: var(--scrim); }
  .svc-in {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: var(--band) auto; column-gap: 24px;
    padding-bottom: clamp(32px, 5vh, 56px);
  }
  h3 { grid-column: 1 / 9; grid-row: 1; align-self: center; font-size: clamp(1.8rem, 3.2vw, 2.75rem); cursor: default; }

  /* "Read more" sits in the title band, so it costs a held sheet no room */
  .read-more {
    grid-column: 9 / -1; grid-row: 1; justify-self: end; align-self: center;
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border: 0; border-radius: 100px;
    font-size: 0.9375rem; font-weight: 500; white-space: nowrap; cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, scale 0.16s var(--ease-out);
  }
  .svc.light .read-more { background: #141414; color: #f4f3ef; }
  .svc.dark .read-more { background: #f4f3ef; color: #141414; }
  @media (hover: hover) and (pointer: fine) { .svc .read-more:hover { background: var(--accent); color: #0a0b0a; } }
  .read-more:active { scale: 0.97; }
  .read-more:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 1199px) { .rm-rest { display: none; } }
  /* no script, no stories to open */
  :global(html:not(.js)) .read-more { display: none; }

  .copy { grid-column: 1 / 7; grid-row: 2; align-self: start; margin-top: 16px; padding-right: clamp(0px, 2vw, 32px); }
  .lead { margin: 0; max-width: 34ch; font-size: clamp(1.15rem, 1.5vw, 1.375rem); line-height: 1.35; font-weight: 500; letter-spacing: -0.01em; }
  .body { margin: 14px 0 0; max-width: 62ch; font-size: 1rem; line-height: 1.55; color: var(--meta); }
  .chips { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { padding: 6px 12px; border-radius: 100px; font-size: 0.875rem; line-height: 1.3; background: color-mix(in srgb, currentColor 9%, transparent); }

  /* each project's own text; while the stack is held, only the active project's shows */
  .blurbs { display: grid; margin-top: 20px; padding-top: 16px; max-width: 62ch; border-top: 1px solid color-mix(in srgb, currentColor 16%, transparent); }
  .blurb { margin: 0; font-size: 1rem; line-height: 1.55; color: var(--meta); }
  .blurb + .blurb { margin-top: 14px; }
  /* on a phone the texts travel with their cards instead (.ptext) */
  @media (max-width: 860px) { .blurbs { display: none; } }
  .bname { display: block; margin-bottom: 4px; font-size: 0.875rem; font-weight: 700; letter-spacing: 0.01em; color: var(--tag); }
  /* the way into the project's story, under its own text */
  .bstory {
    display: flex; align-items: center; gap: 6px; width: fit-content; min-height: 44px; margin-top: 2px;
    font-weight: 600; color: var(--tag); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 0.25em;
    transition: text-decoration-color 0.2s ease;
  }
  .bstory :global(svg) { transition: translate 0.25s var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .bstory:hover { text-decoration-color: currentColor; }
    .bstory:hover :global(svg) { translate: 3px 0; }
  }

  .pstack { grid-column: 7 / -1; grid-row: 2; display: grid; gap: 16px; margin-top: 20px; }
  .pcard {
    position: relative; isolation: isolate; display: flex; flex-direction: column; min-height: 0; overflow: hidden; border-radius: 18px;
    background: var(--card); color: inherit;
  }
  .pband { flex: none; display: flex; align-items: center; gap: 12px; height: var(--pband); padding: 0 18px; }
  .pname { font-weight: 700; font-size: clamp(1.1rem, 1.5vw, 1.35rem); letter-spacing: -0.01em; white-space: nowrap; text-decoration: none; color: inherit; }
  /* the name is the card's link: it covers the whole card, under the "Visit site" link */
  a.pname::after { content: ''; position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  a.pname:focus-visible { outline: none; }
  .pcard:has(a.pname:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .badge {
    flex: none; padding: 3px 9px; border: 1px solid currentColor; border-radius: 100px;
    font-size: 0.75rem; font-weight: 500; line-height: 1.3; color: var(--tag);
  }
  .visit {
    position: relative; z-index: 2; flex: none; margin-left: auto; display: inline-flex; align-items: center; gap: 4px;
    min-height: 44px; font-size: 0.9375rem; font-weight: 500; color: inherit;
    text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 0.25em; transition: text-decoration-color 0.2s ease;
  }
  .visit :global(svg) { transition: translate 0.25s var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .visit:hover { text-decoration-color: currentColor; }
    .visit:hover :global(svg) { translate: 2px -2px; }
  }

  .pmedia { position: relative; display: block; flex: 1 1 auto; min-height: 0; aspect-ratio: 16 / 9; margin: 0 10px; border-radius: 12px; overflow: hidden; background: var(--mbg); color: var(--mfg); }
  .pmedia video, .pmedia img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .pfallback {
    position: absolute; left: 22px; right: 22px; bottom: 18px; font-weight: 700; text-transform: uppercase;
    font-size: clamp(1.6rem, 3.4vw, 3rem); line-height: 0.92; letter-spacing: -0.04em;
  }
  /* the title card repeats the name as a picture, not as text */
  .pfallback::before { content: attr(data-t); }
  /* a live site: the site itself, 1440px wide and scaled to the box (src/scripts/livesites.ts). On a desktop
     the wheel follows the pointer: over the box it scrolls the site, anywhere else the page and its cards.
     On a phone it is only to look at (a finger always scrolls the page), and a tap opens the project like
     the rest of the card */
  .site-live { position: absolute; inset: 0; overflow: hidden; }
  .site-live :global(iframe) { position: absolute; top: 0; left: 0; width: 1440px; height: 100%; border: 0; transform-origin: 0 0; pointer-events: none; }
  @media (hover: hover) and (pointer: fine) and (min-width: 768px) {
    /* above the card's own link, so the pointer here is on the site */
    .site-live { z-index: 2; }
    .site-live :global(iframe) { pointer-events: auto; }
  }
  /* a phone (or any touch screen): "Preview" in the middle of the site opens it full screen */
  .live-preview { display: none; }
  @media not all and (hover: hover) and (pointer: fine) and (min-width: 768px) {
    .live-preview {
      position: absolute; z-index: 2; left: 50%; top: 50%; translate: -50% -50%;
      display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border: 0; border-radius: 100px;
      background: color-mix(in srgb, var(--ink) 86%, transparent); color: var(--ivory); font: inherit; font-size: 0.9375rem; font-weight: 600;
      box-shadow: 0 10px 28px -12px rgb(0 0 0 / 0.55); cursor: pointer; transition: scale 0.16s var(--ease-out);
    }
    .live-preview:active { scale: 0.96; }
    .live-preview:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  }

  /* engineering work: the figure and the scope instead of a picture */
  /* in the flow the card grows to its contents; held in the stack it fills the card like a picture would */
  .spec { display: flex; flex-direction: column; justify-content: space-between; gap: 16px; padding: clamp(18px, 2vw, 26px); aspect-ratio: auto; min-height: 200px; }
  .metric { margin: 0; display: grid; gap: 4px; font-size: 1rem; font-weight: 500; }
  .metric b { font-size: clamp(2.6rem, 5vw, 4.6rem); line-height: 0.9; letter-spacing: -0.05em; }
  .scope { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .scope li { padding: 6px 12px; border-radius: 100px; font-size: 0.875rem; background: color-mix(in srgb, currentColor 12%, transparent); }
  .checks { list-style: none; margin: auto 0 0; padding: 0; display: grid; gap: 12px; font-size: clamp(1rem, 1.3vw, 1.2rem); font-weight: 500; line-height: 1.3; }
  .checks li { display: flex; gap: 10px; align-items: flex-start; }
  .checks :global(svg) { flex: none; margin-top: 0.15em; }
  .pline { flex: none; display: block; margin: 0; padding: 12px 18px 16px; font-size: 0.9375rem; line-height: 1.45; color: var(--meta); }
  /* a phone: under the picture, the project's own text and the way into its story */
  .ptext { display: none; }
  @media (max-width: 860px) {
    .pline { display: none; }
    .ptext { display: block; flex: none; padding: 12px 14px 4px; }
    .ptext p { margin: 0; font-size: 0.9375rem; line-height: 1.5; color: var(--meta); }
    .ptext .bstory { position: relative; z-index: 2; }
    .ptext:not(:has(.bstory)) { padding-bottom: 14px; }
  }
  .again-tab { display: none; }
  .proof .pline a { position: relative; z-index: 2; color: inherit; text-decoration-color: var(--tag); text-underline-offset: 0.25em; }

  /* ---- pinned: the sheets stack over a held screen, and each sheet's projects stack inside it ---- */
  .stack.on { height: calc(100vh + var(--steps) * 62vh + 30vh); }
  .stack.on .pin { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  .stack.on .svc { position: absolute; left: 0; right: 0; top: calc(var(--top) + var(--i) * var(--band)); bottom: 0; }
  .stack.on .svc-in { height: 100%; grid-template-rows: var(--band) minmax(0, 1fr); padding-bottom: 20px; }
  .stack.on .pstack { display: block; position: relative; height: 100%; margin-top: 0; }
  .stack.on .pcard { position: absolute; left: 0; right: 0; top: calc(var(--j) * var(--pband)); bottom: 0; }
  .stack.on .pmedia { aspect-ratio: auto; }
  .stack.on .pline { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .stack.on .copy { margin-top: 0; }
  /* the texts that are not showing step aside too, so their links never catch a click meant for the one that is */
  .stack.on .blurb { grid-area: 1 / 1; margin: 0; opacity: 0; visibility: hidden; transition: opacity 0.3s ease, visibility 0.3s; }
  .stack.on .blurb.on { opacity: 1; visibility: visible; }
  /* a card that has slid over another leaves the one below showing only its name band */
  .stack.on .pcard + .pcard { box-shadow: 0 -10px 24px -18px rgb(0 0 0 / 0.35); }
  /* a shorter screen: slimmer bands and tighter words, so the last sheet keeps room for them */
  @media (max-height: 880px) {
    .stack { --band: 60px; --pband: 58px; }
    .stack.on .body { margin-top: 10px; font-size: 0.9375rem; line-height: 1.5; }
    .stack.on .chips { margin-top: 14px; gap: 6px; }
    .stack.on .chips li { padding: 4px 10px; font-size: 0.8125rem; }
    .stack.on .blurbs { margin-top: 16px; padding-top: 12px; }
  }

  @media (max-width: 860px) {
    .sec-head { grid-template-columns: 1fr; }
    .sec-head p { justify-self: start; }
    .stack { --band: 64px; --pband: 56px; }
    .svc-in { padding-bottom: 28px; }
    h3 { font-size: 1.5rem; }
    h3 { grid-column: 1 / -1; }
    .read-more { grid-column: 1 / -1; grid-row: auto; justify-self: start; margin-top: 20px; }
    .copy, .pstack { grid-column: 1 / -1; }
    .copy { grid-row: auto; margin-top: 0; padding-right: 0; }
    .lead { font-size: 1.125rem; }
    .body { font-size: 0.9375rem; }
    .chips li { padding: 5px 11px; font-size: 0.8125rem; }
    .pstack { grid-row: auto; margin-top: 24px; }
    .pband { padding: 0 14px; gap: 10px; }
    .pline { padding: 10px 14px 12px; }
  }

  /* ---- held on a phone (holdPhone in workstack.ts): the sheets stack like tabs under the bar, each one's title
     band showing above the next. A sheet's title stays while its words scroll up under it; then its projects
     stack, each with its own text under its picture; then the next sheet slides up over it ---- */
  .stack.phone { --tab: 52px; }
  .stack.phone .pin { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  .stack.phone .svc {
