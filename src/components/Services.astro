---
import { services } from '../data/site';
const total = String(services.length).padStart(2, '0');
---
<section id="services" class="wrap">
  <header class="sec-head">
    <h2>What I build</h2>
    <p>Each service, and the real projects behind it — the story behind the curtains.</p>
  </header>

  {services.map((s, i) => (
    <article class="service">
      <div class="head">
        <div class="idx">PP {String(i + 1).padStart(2, '0')} / {total}</div>
        <div>
          <h3>{s.title}</h3>
          <p class="desc">{s.desc}</p>
        </div>
      </div>
      <ul class="projects">
        {s.projects.map((p) => (
          <li class="proj">
            <div class="pn">{p.name}</div>
            <div class="pm">{p.meta}</div>
            <div class="pt">{p.tags}</div>
          </li>
        ))}
      </ul>
    </article>
  ))}
</section>

<style>
  .sec-head { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 48px; align-items: end; margin-bottom: clamp(40px, 7vh, 72px); }
  .sec-head h2 { font-size: clamp(2.4rem, 8vw, 6rem); }
  .sec-head p { margin: 0; color: var(--muted); max-width: 40ch; font-size: 1.1rem; justify-self: end; }
  @media (max-width: 760px) { .sec-head { grid-template-columns: 1fr; } .sec-head p { justify-self: start; } }

  .service { border-top: 1px solid var(--line); padding-block: clamp(36px, 6vh, 72px); }
  .service:last-of-type { border-bottom: 1px solid var(--line); }
  .head { display: grid; grid-template-columns: 9ch 1fr; gap: 28px; align-items: start; }
  .idx { font-size: 0.78rem; color: var(--accent-ink); letter-spacing: 0.08em; white-space: nowrap; padding-top: 0.6em; font-variant-numeric: tabular-nums; }
  h3 { font-size: clamp(1.9rem, 6vw, 3.6rem); }
  .desc { color: var(--muted); max-width: 60ch; margin: 16px 0 0; font-size: 1.05rem; line-height: 1.55; }

  .projects { list-style: none; padding: 0; margin: 34px 0 0 calc(9ch + 28px); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .proj {
    background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 22px;
    transition: border-color 0.3s ease, transform 0.45s var(--ease-out), box-shadow 0.45s var(--ease-out);
  }
  @media (hover: hover) {
    .proj:hover { border-color: var(--accent); transform: translateY(-4px); box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.45); }
  }
  .pn { font-weight: 700; font-size: 1.1rem; letter-spacing: -0.01em; }
  .pm { margin-top: 8px; font-size: 0.88rem; color: var(--muted); line-height: 1.5; }
  .pt { margin-top: 14px; font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-ink); }

  @media (max-width: 960px) { .projects { margin-left: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .head { grid-template-columns: 1fr; gap: 10px; }
    .idx { padding-top: 0; }
    .projects { grid-template-columns: 1fr; }
  }
</style>
