---
import { stories } from '../data/stories';
import { services, ui } from '../data/site';
import StoryArt from './StoryArt.astro';
import StoryDefs from './StoryDefs.astro';

const byKey = Object.fromEntries(services.map((s) => [s.key, s]));
const pad = (n: number) => String(n).padStart(2, '0');
const t = ui.stories;
---
<!-- The service stories (src/scripts/stories.ts). A sheet's "Read more" opens its story as a "thought": a
     rounded box that grows out of the button over the home page, titled with the service; the story plays
     out as it scrolls inside the box, and closing it shrinks it back into the button, the page never having
     moved. The stories are in the page from the start, so search engines read them; without script they
     simply follow the services. -->
<StoryDefs />
<div class="bubble" data-bubble>
  <div class="bubble-backdrop" data-bubble-backdrop></div>
  <span class="bubble-dot" data-bubble-dot></span>
  <span class="bubble-dot" data-bubble-dot></span>
  <span class="bubble-dot" data-bubble-dot></span>

  {stories.map((st) => (
    <article class="story" id={st.id} data-story={st.service} role="dialog" aria-modal="true" aria-labelledby={`${st.id}-title`}>
      <header class="story-top">
        <div class="story-names">
          <h2 id={`${st.id}-title`}>{byKey[st.service].title}</h2>
          <p class="story-kicker">{st.title}</p>
        </div>
        <button type="button" class="story-close" data-story-close aria-label={t.close}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </header>
      <div class="story-scroll" data-story-scroll tabindex="-1">
        {st.scenes.map((sc, i) => (
          <section class="scene" data-scene>
            <div class="scene-art"><StoryArt name={sc.art} /></div>
            <div class="scene-text">
              <p class="scene-num" aria-hidden="true">{pad(i + 1)}</p>
              <h3>{sc.title}</h3>
              <p class="scene-words" data-words>{sc.text}</p>
            </div>
          </section>
        ))}
        <footer class="story-cta">
          <p class="cta-line">{st.cta.text}</p>
          <a class="cta-btn" href={`/contact?type=project&service=${st.service}`}>{t.start}</a>
          {st.cta.note && <p class="cta-note">{st.cta.note}</p>}
        </footer>
      </div>
    </article>
  ))}
</div>

<style>
  /* ---- with script: one story at a time, as a box over the page ---- */
  :global(html.js) .bubble { display: none; }
  :global(html.js) .bubble.open {
    position: fixed; inset: 0; z-index: 90; display: flex; align-items: center; justify-content: center;
    padding: clamp(10px, 3vw, 40px);
  }
  :global(html.js) .story:not(.open) { display: none; }

  .bubble-backdrop { position: absolute; inset: 0; background: rgb(20 20 20 / 0.5); }
  /* the thought's trail: small rounds that rise from the button before the box grows */
  .bubble-dot {
    position: fixed; left: 0; top: 0; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%;
    background: var(--ivory); box-shadow: 0 6px 18px -6px rgb(0 0 0 / 0.4); visibility: hidden; pointer-events: none;
  }

  .story {
    --r: clamp(24px, 3vw, 40px); --art-h: min(56cqh, 440px);
    position: relative; display: flex; flex-direction: column;
    width: min(1180px, 100%); height: 100%; overflow: hidden;
    border-radius: var(--r); background: var(--ivory); color: var(--ink); --accent-ink: #2a55d9;
    box-shadow: 0 40px 90px -30px rgb(0 0 0 / 0.55);
  }
  .story-top {
    flex: none; display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;
    padding: clamp(20px, 3vw, 36px) clamp(20px, 3vw, 40px) clamp(14px, 2vw, 22px);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
  }
  .story-top h2 { font-size: clamp(1.8rem, 4.2vw, 3.6rem); outline: none; }
  .story-kicker { margin: 10px 0 0; font-size: clamp(1rem, 1.4vw, 1.25rem); font-weight: 500; color: var(--accent-ink); }
  .story-close {
    flex: none; display: grid; place-items: center; width: 48px; height: 48px; border: 0; border-radius: 50%; cursor: pointer;
    background: var(--ink); color: var(--ivory); transition: background-color 0.2s ease, scale 0.16s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) { .story-close:hover { background: var(--cobalt); } }
  .story-close:active { scale: 0.94; }
  .story-close:focus-visible { outline: 2px solid var(--cobalt); outline-offset: 3px; }

  /* the story scrolls inside the box; its scenes measure themselves against the box, not the window */
  .story-scroll { position: relative; flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; container-type: size; outline: none; }

  /* a scene: its picture holds still while its words scroll past, sides alternating */
  .scene {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px;
    min-height: 110cqh; padding-inline: clamp(20px, 3vw, 40px);
  }
  .scene-art { grid-column: 1 / 7; grid-row: 1; align-self: start; position: sticky; top: calc((100cqh - var(--art-h)) / 2); }
  .scene-text { grid-column: 8 / -1; grid-row: 1; align-self: center; padding-block: 24cqh; }
  .scene:nth-of-type(even) .scene-art { grid-column: 7 / -1; }
  .scene:nth-of-type(even) .scene-text { grid-column: 1 / 6; }
  .scene-num { margin: 0 0 12px; font-size: 0.9375rem; font-weight: 500; color: var(--accent-ink); font-variant-numeric: tabular-nums; }
  .scene-text h3 { margin: 0; font-size: clamp(1.6rem, 2.8vw, 2.5rem); font-weight: 700; line-height: 0.95; letter-spacing: -0.03em; text-transform: uppercase; text-wrap: balance; }
  .scene-words { margin: 18px 0 0; max-width: 32ch; font-size: clamp(1.2rem, 1.8vw, 1.6rem); line-height: 1.4; font-weight: 500; }
  /* words light up as the scene scrolls by (only once the script has split them) */
  .scene-words :global(.w) { color: color-mix(in srgb, var(--ink) 22%, transparent); transition: color 0.3s ease; }
  .scene-words :global(.w.lit) { color: var(--ink); }

  .story-cta { display: flex; flex-direction: column; align-items: center; gap: 28px; padding: clamp(64px, 12cqh, 140px) 20px; text-align: center; }
  .cta-line { margin: 0; max-width: 18ch; font-size: clamp(2rem, 5vw, 4rem); font-weight: 700; line-height: 0.95; letter-spacing: -0.04em; text-transform: uppercase; text-wrap: balance; }
  .cta-btn {
    display: inline-flex; align-items: center; min-height: 56px; padding: 0 32px; border-radius: 100px;
    background: var(--accent); color: #0a0b0a; font-weight: 700; font-size: 1.0625rem; text-decoration: none;
    transition: background-color 0.2s ease, scale 0.16s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) { .cta-btn:hover { background: #6b92ff; } }
  .cta-btn:active { scale: 0.97; }
  .cta-btn:focus-visible { outline: 2px solid var(--cobalt); outline-offset: 3px; }
  .cta-note { margin: 0; font-size: 0.9375rem; color: color-mix(in srgb, var(--ink) 72%, transparent); }

  /* ---- the line art (StoryArt.astro) ---- */
  .scene-art :global(.sa) { display: block; height: var(--art-h); width: auto; max-width: 100%; margin-inline: auto; overflow: visible; }
  .bubble :global(.sa path), .bubble :global(.sa use) { fill: none; stroke: var(--ink); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .bubble :global(.sa .sa-d) { stroke-dasharray: 1 2; }
  .bubble :global(.sa .ac) { stroke: var(--cobalt); }
  .bubble :global(.sa .thick) { stroke-width: 7; }
  .bubble :global(.sa .solid) { fill: var(--ivory); }
  .bubble :global(.sa circle) { fill: var(--ink); }
  .bubble :global(.sa circle.ac) { fill: var(--cobalt); }
  .bubble :global(.sa text) { fill: var(--ink); font-size: 15px; font-weight: 500; }

  /* idle motion: once a scene is drawn, and only while it is on screen */
  .bubble :global(.sa [class*='i-']) { transform-box: fill-box; transform-origin: 50% 100%; }
  .bubble :global(.sa.idle.inview .i-nod) { animation: sa-nod 3.4s ease-in-out infinite; }
  .bubble :global(.sa.idle.inview .i-bob) { animation: sa-bob 2.8s ease-in-out infinite; }
  .bubble :global(.sa.idle.inview .i-blink) { animation: sa-blink 2.4s ease-in-out infinite; }
  .bubble :global(.sa.idle.inview .i-shake) { animation: sa-shake 2.8s ease-in-out infinite; }
  .bubble :global(.sa.idle.inview .i-click) { animation: sa-click 2.4s ease-in-out infinite; transform-origin: 0 0; }
  .bubble :global(.sa.idle.inview .i-pulse) { animation: sa-pulse 2.8s ease-in-out infinite; transform-origin: 50% 50%; }
  .bubble :global(.sa.idle.inview .i-wave) { animation: sa-wave 2.4s ease-in-out infinite; transform-origin: 0 100%; }
  .bubble :global(.sa.idle.inview .i-grow) { animation: sa-grow 2.6s ease-in-out infinite; }
  .bubble :global(.sa.idle.inview .i-turn) { animation: sa-turn 5s ease-in-out infinite; transform-origin: 50% 50%; }
  .bubble :global(.sa.idle.inview .i-jitter) { animation: sa-jitter 1.6s ease-in-out infinite; transform-box: view-box; transform-origin: 200px 196px; }
  .bubble :global(.sa.idle.inview .i-sway) { animation: sa-sway 4s ease-in-out infinite; }
  .bubble :global(.sa.idle.inview .i-type) { animation: sa-type 1.2s ease-in-out infinite; }
  .bubble :global(.sa.idle.inview .i-fall) { animation: sa-fall 2.2s ease-in infinite; }
  .bubble :global(.sa.idle.inview .i-slide) { animation: sa-slide 3s ease-in-out infinite; }
  .bubble :global(.sa .late) { animation-delay: 0.4s !important; }
  .bubble :global(.sa .later) { animation-delay: 0.8s !important; }
  .bubble :global(.sa .d1) { animation-delay: 0.3s !important; }
  .bubble :global(.sa .d2) { animation-delay: 0.6s !important; }
  .bubble :global(.sa .d3) { animation-delay: 0.9s !important; }
  @keyframes sa-nod { 50% { rotate: -3deg; } }
  @keyframes sa-bob { 50% { translate: 0 -4px; } }
  @keyframes sa-blink { 50% { opacity: 0.3; } }
  @keyframes sa-shake { 0%, 36%, 100% { translate: 0 0; } 12% { translate: 0 3px; } 24% { translate: 0 -2px; } }
  @keyframes sa-click { 0%, 30%, 100% { scale: 1; } 12% { scale: 0.86; } }
  @keyframes sa-pulse { 50% { scale: 1.07; } }
  @keyframes sa-wave { 50% { rotate: 6deg; } }
  @keyframes sa-grow { 50% { scale: 1 1.06; } }
  @keyframes sa-turn { 50% { scale: 0.55 1; } }
  @keyframes sa-jitter { 0%, 100% { rotate: 0deg; } 30% { rotate: 2.5deg; } 60% { rotate: -1.5deg; } }
  @keyframes sa-sway { 50% { translate: -8px 4px; } }
  @keyframes sa-type { 0%, 100% { opacity: 0.25; } 40% { opacity: 1; } }
  @keyframes sa-fall { 0% { translate: 0 -6px; opacity: 0; } 25% { opacity: 1; } 100% { translate: 0 22px; opacity: 0; } }
  @keyframes sa-slide { 50% { translate: 8px 0; } }

  /* a phone: the box fills the screen but for a margin; each picture sits above its words */
  @media (max-width: 899px) {
    :global(html.js) .bubble.open { padding: 10px; }
    .story { --r: 24px; }
    .story-close { width: 44px; height: 44px; }
    .scene { display: block; min-height: 0; padding-block: 40px; }
    .scene-art { position: static; }
    .scene-art :global(.sa) { width: 100%; height: auto; max-width: 440px; }
    .scene-text { padding-block: 20px 0; }
  }

  /* ---- no script: the stories are part of the page, after the services ---- */
  :global(html:not(.js)) .bubble-backdrop, :global(html:not(.js)) .bubble-dot, :global(html:not(.js)) .story-close { display: none; }
  :global(html:not(.js)) .story { width: auto; height: auto; overflow: visible; border-radius: 0; box-shadow: none; }
  :global(html:not(.js)) .story-scroll { overflow: visible; container-type: normal; }
  :global(html:not(.js)) .scene { min-height: 0; }
  :global(html:not(.js)) .scene-art { position: static; }
  :global(html:not(.js)) .scene-art :global(.sa) { height: auto; width: 100%; max-width: 440px; }
  :global(html:not(.js)) .scene-text { padding-block: 24px; }
</style>
