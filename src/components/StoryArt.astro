---
// One illustration of a service story, by name: single-line art in --ink on the ivory, with one --cobalt
// accent per scene ("One Continuous Line"). Every stroke can draw itself on (`sa-d`, pathLength 1),
// small dots fade in (`sa-f`), and `i-*` groups carry the idle motion once a scene is drawn
// (src/scripts/stories.ts). Each picture is drawn as its scene ends (that is also how it rests with reduced
// motion): `data-lift` and `data-turn-from` say where a part comes from. The shared people and props are
// symbols in StoryDefs.astro, used with <use>.
import { r1, C, R, cls, P, D, T } from './lineart';

interface Props { name: string }
const { name } = Astro.props;

type N = number;
/** a shared person or prop */
const U = (id: string, t: string, extra = '') => `<use class="${cls('sa-d', extra)}" href="#sa-${id}" transform="${t}"/>`;
/** a group with idle motion (the motion lives on its own group, so it never fights a placement transform) */
const I = (motion: string, inner: string, style = '') => `<g class="${motion}"${style ? ` style="${style}"` : ''}>${inner}</g>`;
/** a point on a cubic Bézier, for things placed along a curve */
const bez = (p: N[], t: N) => {
  const u = 1 - t;
  return [0, 1].map((k) => u * u * u * p[k] + 3 * u * u * t * p[2 + k] + 3 * u * t * t * p[4 + k] + t * t * t * p[6 + k]);
};
/** a point at an angle on a circle (degrees, counter-clockwise from 3 o'clock, as on paper) */
const at = (cx: N, cy: N, r: N, deg: N) => [r1(cx + r * Math.cos((deg * Math.PI) / 180)), r1(cy - r * Math.sin((deg * Math.PI) / 180))];

