---
// The people and props the story illustrations share (StoryArt.astro draws them with <use>). Each stroke has
// pathLength 1, so a <use> draws on as one piece when its dash offset moves (the offset is inherited).
const C = (cx: number, cy: number, r: number) => `M${cx - r} ${cy}a${r} ${r} 0 1 0 ${2 * r} 0a${r} ${r} 0 1 0 ${-2 * r} 0`;
const R = (x: number, y: number, w: number, h: number, r: number) =>
  `M${x + r} ${y}h${w - 2 * r}a${r} ${r} 0 0 1 ${r} ${r}v${h - 2 * r}a${r} ${r} 0 0 1 ${-r} ${r}h${-(w - 2 * r)}a${r} ${r} 0 0 1 ${-r} ${-r}v${-(h - 2 * r)}a${r} ${r} 0 0 1 ${r} ${-r}z`;
const shapes: Record<string, string[]> = {
  // a person, faceless: a head and shoulders, standing on (0, 0)
  person: [C(0, -72, 13), 'M-32 0C-32 -30 -18 -48 0 -48C18 -48 32 -30 32 0'],
  // a browser window, 140 × 96 from (0, 0)
  screen: [R(0, 0, 140, 96, 8), 'M0 18H140', C(10, 9, 2.2) + C(18, 9, 2.2) + C(26, 9, 2.2)],
  // a page with a folded corner, 80 × 104
  doc: ['M0 0H60L80 20V104H0Z', 'M60 0V20H80', 'M12 38H62M12 52H68M12 66H54M12 80H62'],
  // a product card, 64 × 84
  card: [R(0, 0, 64, 84, 6), R(8, 8, 48, 34, 4), 'M8 54H48M8 66H34'],
  // a parcel, 32 × 38
  box: ['M0 9L16 0L32 9V29L16 38L0 29Z', 'M0 9L16 18L32 9M16 18V38'],
};
---
<svg class="sa-defs" aria-hidden="true" focusable="false" width="0" height="0">
  <defs>
    {Object.entries(shapes).map(([id, ds]) => <g id={`sa-${id}`}>{ds.map((d) => <path pathLength="1" d={d} />)}</g>)}
  </defs>
</svg>

<style>
  .sa-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
</style>
