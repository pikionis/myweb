---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
// the two weights the first screen sets (text and headings), fetched with the page rather than after its styles
import font400 from '@fontsource/space-grotesk/files/space-grotesk-latin-400-normal.woff2?url';
import font700 from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url';
import '../styles/global.css';
import { person, meta, brand, services } from '../data/site';
// the site's language, which the page declares: Greek capitals lose their accents when uppercased only on a page
// that says it is Greek
import { lang } from '../data/lang';

// `light`: the page opens on the warm light ground (every page but the home page, whose dark hero comes first)
interface Props { title?: string; description?: string; light?: boolean }
const {
  title = `${person.name} — ${person.role}`,
  description = meta.description,
  light = false,
} = Astro.props;

// every page names its one address (folders end in a slash, as GitHub Pages serves them) and its share picture
const origin = (Astro.site ?? new URL('https://onehublabs.com')).origin;
const path = Astro.url.pathname;
const canonical = origin + (path.endsWith('/') || /\.\w+$/.test(path) ? path : `${path}/`);
const image = origin + meta.image;

// Structured data, the same on every page: who builds, the business, and the site itself
const [locality, country] = person.location.split(' · ');
const address = { '@type': 'PostalAddress', addressLocality: locality, addressCountry: country };
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person', '@id': `${origin}/#person`, name: person.name, jobTitle: person.role, url: `${origin}/`,
      email: `mailto:${person.email}`, telephone: person.phone, address, sameAs: [person.linkedin, person.github],
    },
    {
      '@type': 'ProfessionalService', '@id': `${origin}/#business`, name: brand.name, url: `${origin}/`,
      description: meta.description, logo: `${origin}/logo.png`, image, email: person.email, telephone: person.phone, address,
      founder: { '@id': `${origin}/#person` },
      hasOfferCatalog: {
        '@type': 'OfferCatalog', name: 'Services',
        itemListElement: services.map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s.title, description: s.summary ?? s.lead, url: `${origin}/services/` },
        })),
      },
    },
    {
      '@type': 'WebSite', '@id': `${origin}/#website`, url: `${origin}/`, name: person.name, description: meta.description,
      inLanguage: lang, author: { '@id': `${origin}/#person` }, publisher: { '@id': `${origin}/#business` },
    },
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={light ? '#f4f3ef' : '#0a0b0a'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:locale" content={{ en: 'en_US', el: 'el_GR', de: 'de_CH' }[lang]} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={meta.imageAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="preload" href={font700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={font400} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <!-- Picks the opening intro before the first paint (src/scripts/intro.ts): the full intro once per session on
         the home page (a still logo with reduced motion), otherwise only the header logo fading in, so a visitor who
         arrives on another page gets that page at once. If the intro's script never arrives, the failsafe takes the
         overlay away so the page is never left covered. -->
    <script is:inline>
      (function () {
        var html = document.documentElement, mode = 'quick';
        // script is running: things that only open with script (the service stories) can start closed
        html.classList.add('js');
        try {
          if (location.pathname === '/' && !sessionStorage.getItem('ohl-intro')) {
            mode = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'still' : 'full';
          }
        } catch (e) { /* no storage: no intro */ }
        html.setAttribute('data-intro', mode);
        if (mode === 'quick') return;
        html.classList.add('ohl-lock');
        setTimeout(function () {
          if (window.__ohl) return;
          html.setAttribute('data-intro', 'done');
          html.classList.remove('ohl-lock');
        }, 3000);
      })();
    </script>
  </head>
  <body class:list={{ light }}>
    <slot />
  </body>
</html>
