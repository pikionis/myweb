---
// An address that isn't here (GitHub Pages serves dist/404.html for every one of them). A project's address that no
// longer exists goes on to /projects in its language, so a project taken down leaves no dead link behind it.
import Site from '../layouts/Site.astro';
import { words } from '../data/site';
import { to } from '../data/lang';

const w = words.notFound;
---
<Site title={w.metaTitle} description={w.text} light>
  <script is:inline>
    (function () {
      var m = location.pathname.match(/^\/(el\/|de\/)?projects\/[^/]+\/?$/);
      if (m) location.replace('/' + (m[1] || '') + 'projects/');
    })();
  </script>
  <main class="page theme-light">
    <header class="wrap page-head">
      <h1>{w.title}</h1>
      <p>{w.text}</p>
      <a class="home" href={to('/')}>{w.home}</a>
    </header>
  </main>
</Site>

<style>
  .home {
    display: inline-flex; align-items: center; min-height: 48px; margin-top: 28px; padding: 0 22px; border-radius: 100px;
    background: var(--ink); color: var(--paper); font-weight: 600; text-decoration: none;
  }
  .home:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
</style>
