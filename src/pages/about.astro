---
import Site from '../layouts/Site.astro';
import Terrain from '../components/Terrain.astro';
import { person, hero, stats } from '../data/site';

const location = person.location.replace(' · ', ', ');
---
<Site title="About me — Petros Pikionis" description={`${person.name}, ${person.role} based in ${location}.`} light>
  <main class="page theme-light">
    <header class="wrap page-head" data-rise>
      <h1>About me</h1>
      <p>{person.role} in {location}. Every column below is a day I pushed code to GitHub.</p>
    </header>

    <!-- the bio opens with the work itself: a year of commits -->
    <div class="wrap"><Terrain /></div>

    <section class:list={['wrap', 'bio', { 'has-photo': person.photo }]} data-rise>
      <h2 class="sr-only">Bio</h2>
      {person.photo && <img class="portrait" src={person.photo} alt={`Portrait of ${person.name}`} width="480" height="640" />}
      <p class="lead">{hero.intro}</p>
      <div class="side">
        <p>{hero.palette}</p>
        <h3>What I work on</h3>
        <ul class="areas">
          {hero.corners.map((c) => <li>{c.top} {c.bold}</li>)}
        </ul>
      </div>
      <ul class="numbers">
        {stats.map((s) => <li><b>{s.value}{s.suffix}</b> {s.label}</li>)}
      </ul>
    </section>
  </main>
</Site>

<style>
  .bio {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; row-gap: clamp(48px, 8vh, 88px);
    padding-block: clamp(80px, 12vh, 140px) 0;
  }
  /* the main paragraph on the left, what I do on the right; with a portrait, both move beside it */
  .lead { grid-column: 1 / 8; margin: 0; font-size: clamp(1.3rem, 2.1vw, 1.9rem); line-height: 1.35; letter-spacing: -0.01em; max-width: 32ch; }
  .side { grid-column: 9 / -1; align-self: end; }
  .side p { margin: 0; font-size: 1.0625rem; line-height: 1.6; max-width: 44ch; }
  .side h3 { margin: 32px 0 0; font-size: clamp(1.4rem, 2.2vw, 1.9rem); }
  .portrait { grid-column: 1 / 5; grid-row: span 2; width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 14px; }
  .has-photo .lead, .has-photo .side { grid-column: 6 / -1; }
  .has-photo .side { align-self: start; }
  .areas { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .areas li { background: var(--surface); border-radius: 100px; padding: 10px 18px; font-size: 1.0625rem; font-weight: 500; }
  .numbers { grid-column: 1 / -1; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .numbers li { font-size: 1.0625rem; line-height: 1.4; }
  .numbers b { display: block; font-size: clamp(2.4rem, 5vw, 4.5rem); line-height: 1; letter-spacing: -0.04em; margin-bottom: 8px; }

  @media (max-width: 860px) {
    .portrait { grid-column: 1 / -1; grid-row: auto; max-width: 320px; }
    .lead, .side, .has-photo .lead, .has-photo .side { grid-column: 1 / -1; }
    .numbers { grid-template-columns: 1fr 1fr; row-gap: 32px; }
  }
</style>
