---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Site from '../layouts/Site.astro';
import Terrain from '../components/Terrain.astro';
import MyStory from '../components/MyStory.astro';
import { person, hero, stats } from '../data/site';
import { aboutIntro, t } from '../data/mystory';

const location = person.location.replace(' · ', ', ');
// "Download CV" shows once the PDF is in public/ (while developing it always shows, so it can be seen)
const cv = person.cv && (import.meta.env.DEV || existsSync(join(process.cwd(), 'public', person.cv))) ? person.cv : undefined;
const down = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>';
---
<Site title="About me — Petros Pikionis" description={`${person.name}, ${person.role} based in ${location}.`} light>
  <main class="page theme-light about">
    <!-- who this is, first: the portrait, what I do, the CV; then the story, what I work on, and a year of code -->
    <section class="wrap me">
      <figure class="portrait">
        {person.photo ? (
          <img src={person.photo} alt={`Portrait of ${person.name}`} width="480" height="640" fetchpriority="high" />
        ) : (
          <div class="ph" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            <small>public/petros.webp</small>
          </div>
        )}
        <figcaption>
          <span class="cap-name">{person.name}</span>
          <span class="cap-role">{person.role} · {location}</span>
        </figcaption>
      </figure>
      <div class="me-text" data-rise>
        <h1>About me</h1>
        <p class="lead">{hero.intro}</p>
        <p class="palette">{hero.palette}</p>
        {cv && <a class="cv" href={cv} download>{t(aboutIntro.cv)}<Fragment set:html={down} /></a>}
      </div>
    </section>

    <div class="wrap"><MyStory cv={cv} /></div>

    <section class="wrap bio" data-rise>
      <h2>What I work on</h2>
      <ul class="areas">
        {hero.areas.map((a) => <li>{a}</li>)}
      </ul>
      <ul class="numbers">
        {stats.map((s) => <li><b>{s.value}{s.suffix}</b> {s.label}</li>)}
      </ul>
    </section>

    <!-- last, the work itself: a year of commits -->
    <section class="wrap code" aria-labelledby="code-title">
      <header class="code-head" data-rise>
        <h2 id="code-title">A year of code</h2>
        <p>Every column is a day I pushed code to GitHub.</p>
      </header>
      <Terrain />
    </section>
  </main>
</Site>

<style>
  /* the page opens on the portrait, closer to the bar than other pages' titles */
  .about { padding-top: calc(var(--topbar-h) + clamp(24px, 5vh, 56px)); }
  /* the portrait holds its place while the words beside it are read */
  .me {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: clamp(28px, 5vw, 80px); align-items: start;
    padding-bottom: clamp(40px, 8vh, 96px);
  }
  /* a screen high at most, so all of it and its caption stay in view while it holds */
  .portrait { position: sticky; top: calc(var(--topbar-h) + 24px); margin: 0; max-width: calc((100svh - var(--topbar-h) - 120px) * 0.75); }
  .portrait img, .ph { display: block; width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 14px; }
  .ph { display: grid; place-content: center; justify-items: center; gap: 14px; border: 1px solid var(--line); background: var(--surface); color: var(--accent-ink); }
  .ph small { color: var(--muted); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; }
  figcaption { display: grid; gap: 6px; margin-top: 16px; }
  .cap-name { font-size: 1.125rem; font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; line-height: 1.1; }
  .cap-role { font-size: 0.75rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .me-text { align-self: center; }
  .me-text h1 { font-size: clamp(3rem, 6.4vw, 5.6rem); }
  .lead { margin: clamp(20px, 3vh, 32px) 0 0; font-size: clamp(1.3rem, 2.1vw, 1.9rem); line-height: 1.35; letter-spacing: -0.01em; max-width: 32ch; }
  .palette { margin: 18px 0 0; font-size: 1.0625rem; line-height: 1.6; max-width: 44ch; color: var(--muted); }
  .cv {
    display: inline-flex; align-items: center; gap: 8px; min-height: 52px; margin-top: 28px; padding: 0 24px; border-radius: 100px;
    background: var(--ink); color: var(--paper); font-weight: 600; text-decoration: none; transition: scale 0.16s var(--ease-out), opacity 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) { .cv:hover { opacity: 0.86; } }
  .cv:active { scale: 0.97; }
  .cv:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .bio { padding-block: clamp(80px, 12vh, 140px) 0; }
  .bio h2, .code-head h2 { font-size: clamp(1.8rem, 3.4vw, 3rem); }
  .areas { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .areas li { background: var(--surface); border-radius: 100px; padding: 10px 18px; font-size: 1.0625rem; font-weight: 500; }
  .numbers { list-style: none; margin: clamp(48px, 8vh, 88px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .numbers li { font-size: 1.0625rem; line-height: 1.4; }
  .numbers b { display: block; font-size: clamp(2.4rem, 5vw, 4.5rem); line-height: 1; letter-spacing: -0.04em; margin-bottom: 8px; }

  .code { padding-block: clamp(80px, 12vh, 140px) clamp(40px, 6vh, 80px); }
  .code-head { display: flex; align-items: end; justify-content: space-between; gap: 16px 32px; flex-wrap: wrap; margin-bottom: 24px; }
  .code-head p { margin: 0; color: var(--muted); }

  @media (max-width: 860px) {
    .me { grid-template-columns: minmax(0, 1fr); row-gap: 28px; }
    .portrait { position: static; max-width: 280px; }
    .numbers { grid-template-columns: 1fr 1fr; row-gap: 32px; }
  }
</style>
