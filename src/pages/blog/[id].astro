---
import Site from '../../layouts/Site.astro';
import { render } from 'astro:content';
import { getPosts, type Post } from '../../data/posts';
import { person, words } from '../../data/site';
import { day as dated, to } from '../../data/lang';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const day = dated(post.data.date);
---
<Site title={`${post.data.title} — ${person.name}`} description={post.data.description} light>
  <main class="page theme-light">
    <article class="wrap">
      <header class="head" data-rise>
        <time datetime={post.data.date.toISOString()}>{day}</time>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
      </header>
      <div class="prose"><Content /></div>
      <p class="back"><a href={to('/blog')}>{words.blog.all}</a></p>
    </article>
  </main>
</Site>

<style>
  .head { max-width: 980px; margin-bottom: clamp(40px, 7vh, 72px); }
  time { font-size: 0.9375rem; color: var(--muted); }
  /* a post title is a sentence: set it at heading size, not the display size, so it stays within two lines */
  h1 { margin-top: 14px; font-size: clamp(2rem, 4.4vw, 3.6rem); text-wrap: balance; }
  .head p { margin: 20px 0 0; max-width: 56ch; font-size: clamp(1.15rem, 1.6vw, 1.4rem); line-height: 1.45; }
  .back { margin: clamp(56px, 9vh, 96px) 0 0; font-size: 1.0625rem; }
  .back a { text-decoration-color: var(--accent); text-underline-offset: 0.25em; }
</style>
