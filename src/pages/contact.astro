---
import Site from '../layouts/Site.astro';
import Contact from '../components/Contact.astro';
import { person, words } from '../data/site';
import { fill } from '../data/lang';
---
<!-- the contact block is the whole page here, so it isn't repeated as a footer -->
<Site title={words.contact.metaTitle} description={fill(words.contact.metaDescription, { name: person.name })} footer={false}>
  <main>
    <Contact page />
  </main>
</Site>
