---
// /projects/<id>: the same panel, opening on this project (src/components/ProjectsHub.astro)
import Site from '../../layouts/Site.astro';
import ProjectsHub from '../../components/ProjectsHub.astro';
import { getProjects, type ProjectEntry } from '../../data/projects';
import { person } from '../../data/site';

export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: ProjectEntry };
---
<Site title={`${project.data.title} — ${person.name}`} description={project.data.summary} light>
  <ProjectsHub selected={project.id} />
</Site>
