---
import Site from '../../layouts/Site.astro';
import { render } from 'astro:content';
import { getProjects, servicesWithProjects, otherProjects, hasStory } from '../../data/projects';
import { services, ui } from '../../data/site';

const all = await getProjects();
// the four services, then the work that sits outside them
const groups = [
  ...(await servicesWithProjects()).map((g) => ({ title: g.title, projects: g.projects })),
  { title: ui.moreWork, projects: await otherProjects() },
].filter((g) => g.projects.length);
const titleOf = (k: string) => services.find((s) => s.key === k)?.title ?? k;
// everything the showcase needs, in carousel order
const projects = all.map((p) => ({
  id: p.id,
  title: p.data.title,
  summary: p.data.summary,
  services: p.data.services.length ? p.data.services.map(titleOf) : [ui.moreWork],
  serviceKeys: p.data.services,
  tags: p.data.tags,
  url: p.data.url,
  cover: p.data.cover,
  video: p.data.video,
  story: hasStory(p),
}));
// written stories travel with the page so the panel can show them without a reload
const stories = await Promise.all(all.filter(hasStory).map(async (p) => ({ id: p.id, Content: (await render(p)).Content })));
---
<Site title="Projects — Petros Pikionis" description="Websites, AI SaaS and web applications, e-commerce and marketplace engineering by Petros Pikionis." light>
  <main class="page theme-light projects">
    <header class="wrap page-head" data-head data-rise>
      <h1>Projects</h1>
      <p>{projects.length} projects across websites, web applications, e-commerce and marketplace engineering. Drag the row, open any project.</p>
    </header>

    <section class="showcase" data-showcase aria-label="Project showcase">
      <div class="stage" data-stage tabindex="0" role="region" aria-roledescription="carousel" aria-label="Projects. Arrow keys move, Enter opens.">
        <!-- the label scales with the canvas, so it stays under the pointer when the carousel shrinks -->
        <div class="glass" data-glass><span class="view" data-view aria-hidden="true">View</span></div>
      </div>
      <p class="current" data-current aria-live="polite"></p>

      <!-- the opened project: its design video, and a panel that explains it -->
      <div class="wrap detail" data-detail hidden>
        <div class="media" data-media></div>
        <article class="panel" data-panel>
          <button type="button" class="close" data-p-close aria-label="Close project">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </button>
          <p class="p-services" data-p-services></p>
          <h2 data-p-title></h2>
          <p class="p-summary" data-p-summary></p>
          <div class="prose p-story" data-p-story hidden></div>
          <ul class="p-tags" data-p-tags aria-label="Built with"></ul>
          <div class="p-actions">
            <a data-p-visit href="#" target="_blank" rel="noopener" hidden>Visit site</a>
            <a data-p-read href="#" hidden>Read the full story</a>
          </div>
        </article>
      </div>
    </section>

    <section class="wrap index" aria-labelledby="index-title">
      <h2 id="index-title">All projects</h2>
      {groups.map((g) => (
        <div class="group">
          <h3>{g.title}</h3>
          <ul class="list" data-rise>
            {g.projects.map((p) => (
              <li>
                <button type="button" class="name" data-open={p.id}>{p.data.title}</button>
                <p class="sum">{p.data.summary}</p>
                <p class="tags">{p.data.tags.join(' · ')}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <script type="application/json" data-projects set:html={JSON.stringify(projects)} />
    {stories.map(({ id, Content }) => <template data-story={id}><Content /></template>)}
  </main>
</Site>

<script>
  import { projectsShowcase } from '../../scripts/projects';
  const root = document.querySelector<HTMLElement>('[data-showcase]');
  if (root) projectsShowcase(root);
</script>

<style>
  .projects { padding-top: clamp(110px, 15vh, 170px); }
  .projects .page-head { overflow: hidden; }

  /* ---- the carousel ---- */
  .showcase { padding: 0; }
  .stage { position: relative; height: clamp(420px, 64vh, 680px); outline: none; }
  .stage:focus-visible { box-shadow: inset 0 0 0 2px var(--accent); }
  .glass { position: absolute; inset: 0 0 auto 0; height: 100%; }
  .view {
    position: absolute; left: 0; top: 0; z-index: 2; pointer-events: none; opacity: 0;
    padding: 8px 14px; border-radius: 100px; background: #141414; color: #f4f3ef; font-size: 0.9375rem; font-weight: 500;
  }
  .current { display: flex; flex-direction: column; align-items: center; gap: 2px; margin: 8px 0 0; text-align: center; min-height: 3em; }
  .current :global(b) { font-size: clamp(1.15rem, 1.6vw, 1.4rem); letter-spacing: -0.01em; }
  .current :global(span) { font-size: 0.9375rem; color: var(--muted); }

  /* ---- the opened project ---- */
  .detail { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; align-items: start; margin-top: clamp(24px, 4vh, 40px); }
  .media { grid-column: 1 / 8; position: relative; aspect-ratio: 16 / 10; border-radius: 20px; overflow: hidden; background: #141414; }
  .media :global(video), .media :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .media[data-kind='card'] :global(img) { object-fit: contain; }
  .panel { grid-column: 8 / -1; position: relative; border-radius: 20px; background: #ffffff; padding: clamp(24px, 3vw, 36px); }
  .close {
    position: absolute; top: 16px; right: 16px; width: 40px; height: 40px; border: 0; border-radius: 50%;
    display: grid; place-items: center; background: #f1f0eb; color: #141414; cursor: pointer;
    transition: background-color 0.15s ease, scale 0.16s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) { .close:hover { background: #e2e0d9; } }
  .close:active { scale: 0.94; }
  .close:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .p-services { margin: 0; padding-right: 48px; font-size: 0.9375rem; font-weight: 500; color: var(--accent-ink); }
  .panel h2 { margin-top: 10px; font-size: clamp(1.8rem, 3.2vw, 2.75rem); padding-right: 40px; }
  .p-summary { margin: 16px 0 0; font-size: clamp(1.15rem, 1.6vw, 1.4rem); line-height: 1.45; }
  .p-story { margin-top: 24px; font-size: 1.0625rem; }
  .p-tags { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .p-tags :global(li) { padding: 7px 14px; border-radius: 100px; background: #f1f0eb; font-size: 0.9375rem; }
  .p-actions { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 24px; font-size: 1.0625rem; }
  .p-actions a { text-decoration-color: var(--accent); text-underline-offset: 0.25em; }

  /* ---- the index ---- */
  .index { padding-block: clamp(80px, 12vh, 140px) 0; }
  .index > h2 { font-size: clamp(1.8rem, 3.2vw, 2.75rem); margin-bottom: clamp(24px, 4vh, 48px); }
  .group { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; padding-block: clamp(28px, 5vh, 52px); }
  .group h3 { grid-column: 1 / 6; align-self: start; position: sticky; top: 100px; font-size: clamp(1.3rem, 2.1vw, 1.9rem); }
  .list { grid-column: 7 / -1; list-style: none; margin: 0; padding: 0; display: grid; gap: 32px; }
  .name {
    padding: 0; border: 0; background: none; color: inherit; font: inherit; cursor: pointer; text-align: left;
    font-weight: 700; font-size: clamp(1.3rem, 2vw, 1.7rem); letter-spacing: -0.02em; line-height: 1.15;
    text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 0.18em; text-decoration-thickness: 2px;
    transition: text-decoration-color 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) { .name:hover { text-decoration-color: var(--accent); } }
  .name:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
  .sum { margin: 8px 0 0; font-size: 1.0625rem; line-height: 1.5; max-width: 52ch; }
  .tags { margin: 6px 0 0; font-size: 0.9375rem; color: var(--accent-ink); }

  @media (max-width: 860px) {
    .stage { height: clamp(380px, 58vh, 560px); }
    .media, .panel { grid-column: 1 / -1; }
    .group h3, .list { grid-column: 1 / -1; }
    .group h3 { position: static; margin-bottom: 20px; }
  }
</style>
